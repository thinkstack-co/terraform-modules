 155 │ 143 │     def validate_utf16_characters(self, pair: List[int]) -> None:              
 156 │ 144 │         """                                                                    
 157 │ 145 │         Validate if the pair of bytes is  valid UTF-16.                        
 158 │ 146 │                                                                                
 159 │ 147 │         UTF-16 is valid in the range 0x0000 - 0xFFFF excluding 0xD800 - 0xFFFF 
 160 │ 148 │         with an exception for surrogate pairs, which must be in the range      
 161 │ 149 │         0xD800-0xDBFF followed by 0xDC00-0xDFFF                                
 162 │ 150 │                                                                                
 163 │ 151 │         https://en.wikipedia.org/wiki/UTF-16                                   
 164 │ 152 │         """                                                                    
