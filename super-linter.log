 397 │ 397 │ def mac_platforms(                                                                         
 398 │ 398 │     version: AppleVersion | None = None, arch: str | None = None                           
 399 │ 399 │ ) -> Iterator[str]:                                                                        
 400 │ 400 │     """                                                                                    
 401 │ 401 │     Yields the platform tags for a macOS system.                                           
 402 │ 402 │                                                                                            
 403 │ 403 │     The `version` parameter is a two-item tuple specifying the macOS version to            
 404 │ 404 │     generate platform tags for. The `arch` parameter is the CPU architecture to            
 405 │ 405 │     generate platform tags for. Both parameters default to the appropriate value           
 406 │ 406 │     for the current system.                                                                
 407 │ 407 │     """                                                                                    
 408 │ 408 │     version_str, _, cpu_arch = platform.mac_ver()                                          
 409 │ 409 │     if version is None:                                                                    
 410 │ 410 │         version = cast("AppleVersion", tuple(map(int, version_str.split(".")[:2])))        
 411 │ 411 │         if version == (10, 16):                                                            
 412 │ 412 │             # When built against an older macOS SDK, Python will report macOS 10.16        
 413 │ 413 │             # instead of the real version.                                                 
 414 │ 414 │             version_str = subprocess.run(                                                  
 415 │ 415 │                 [                                                                          
 416 │ 416 │                     sys.executable,                                                        
 417 │ 417 │                     "-sS",                                                                 
 418 │ 418 │                     "-c",                                                                  
 419 │ 419 │                     "import platform; print(platform.mac_ver()[0])",                       
 420 │ 420 │                 ],                                                                         
 421 │ 421 │                 check=True,                                                                
 422 │ 422 │                 env={"SYSTEM_VERSION_COMPAT": "0"},                                        
 423 │ 423 │                 stdout=subprocess.PIPE,                                                    
 424 │ 424 │                 text=True,                                                                 
 425 │ 425 │             ).stdout                                                                       
 426 │ 426 │             version = cast("AppleVersion", tuple(map(int, version_str.split(".")[:2])))    
 427 │ 427 │     else:                                                                                  
 428 │ 428 │         version = version                                                                  
 429 │ 429 │     if arch is None:                                                                       
 430 │ 430 │         arch = _mac_arch(cpu_arch)                                                         
 431 │ 431 │     else:                                                                                  
 432 │ 432 │         arch = arch                                                                        
 433 │ 433 │                                                                                            
 434 │ 434 │     if (10, 0) <= version and version < (11, 0):                                           
 435 │ 435 │         # Prior to Mac OS 11, each yearly release of Mac OS bumped the                     
 436 │ 436 │         # "minor" version number.  The major version was always 10.                        
 437 │ 437 │         major_version = 10                                                                 
 438 │ 438 │         for minor_version in range(version[1], -1, -1):                                    
 439 │ 439 │             compat_version = major_version, minor_version                                  
 440 │ 440 │             binary_formats = _mac_binary_formats(compat_version, arch)                     
 441 │ 441 │             for binary_format in binary_formats:                                           
 442 │ 442 │                 yield f"macosx_{major_version}_{minor_version}_{binary_format}"            
 443 │ 443 │                                                                                            
 444 │ 444 │     if version >= (11, 0):                                                                 
 445 │ 445 │         # Starting with Mac OS 11, each yearly release bumps the major version             
 446 │ 446 │         # number.   The minor versions are now the midyear updates.                        
 447 │ 447 │         minor_version = 0                                                                  
 448 │ 448 │         for major_version in range(version[0], 10, -1):                                    
 449 │ 449 │             compat_version = major_version, minor_version                                  
 450 │ 450 │             binary_formats = _mac_binary_formats(compat_version, arch)                     
 451 │ 451 │             for binary_format in binary_formats:                                           
 452 │ 452 │                 yield f"macosx_{major_version}_{minor_version}_{binary_format}"            
 453 │ 453 │                                                                                            
 454 │ 454 │     if version >= (11, 0):                                                                 
 455 │ 455 │         # Mac OS 11 on x86_64 is compatible with binaries from previous releases.          
 456 │ 456 │         # Arm64 support was introduced in 11.0, so no Arm binaries from previous           
 457 │ 457 │         # releases exist.                                                                  
 458 │ 458 │         #                                                                                  
 459 │ 459 │         # However, the "universal2" binary format can have a                               
 460 │ 460 │         # macOS version earlier than 11.0 when the x86_64 part of the binary supports      
 461 │ 461 │         # that version of macOS.                                                           
 462 │ 462 │         major_version = 10                                                                 
 463 │ 463 │         if arch == "x86_64":                                                               
 464 │ 464 │             for minor_version in range(16, 3, -1):                                         
 465 │ 465 │                 compat_version = major_version, minor_version                              
 466 │ 466 │                 binary_formats = _mac_binary_formats(compat_version, arch)                 
 467 │ 467 │                 for binary_format in binary_formats:                                       
 468 │ 468 │                     yield f"macosx_{major_version}_{minor_version}_{binary_format}"        
 469 │ 469 │         else:                                                                              
 470 │ 470 │             for minor_version in range(16, 3, -1):                                         
 471 │ 471 │                 compat_version = major_version, minor_version                              
 472 │ 472 │                 binary_format = "universal2"                                               
 473 │ 473 │                 yield f"macosx_{major_version}_{minor_version}_{binary_format}"            
 474 │ 474 │                                                                                            
