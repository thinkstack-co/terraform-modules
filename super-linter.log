 115 │ 115 │ # Deliberately not anchored to the start and end of the string, to make it               
 116 │ 116 │ # easier for 3rd party code to reuse                                                     
 117 │ 117 │ _VERSION_PATTERN = r"""                                                                  
 118 │ 118 │     v?                                                                                   
 119 │ 119 │     (?:                                                                                  
 120 │ 120 │         (?:(?P<epoch>[0-9]+)!)?                           # epoch                        
 121 │ 121 │         (?P<release>[0-9]+(?:\.[0-9]+)*)                  # release segment              
 122 │ 122 │         (?P<pre>                                          # pre-release                  
 123 │ 123 │             [-_\.]?                                                                      
 124 │ 124 │             (?P<pre_l>alpha|a|beta|b|preview|pre|c|rc)                                   
 125 │ 125 │             [-_\.]?                                                                      
 126 │ 126 │             (?P<pre_n>[0-9]+)?                                                           
 127 │ 127 │         )?                                                                               
 128 │ 128 │         (?P<post>                                         # post release                 
 129 │ 129 │             (?:-(?P<post_n1>[0-9]+))                                                     
 130 │ 130 │             |                                                                            
 131 │ 131 │             (?:                                                                          
 132 │ 132 │                 [-_\.]?                                                                  
 133 │ 133 │                 (?P<post_l>post|rev|r)                                                   
 134 │ 134 │                 [-_\.]?                                                                  
 135 │ 135 │                 (?P<post_n2>[0-9]+)?                                                     
 136 │ 136 │             )                                                                            
 137 │ 137 │         )?                                                                               
 138 │ 138 │         (?P<dev>                                          # dev release                  
 139 │ 139 │             [-_\.]?                                                                      
 140 │ 140 │             (?P<dev_l>dev)                                                               
 141 │ 141 │             [-_\.]?                                                                      
 142 │ 142 │             (?P<dev_n>[0-9]+)?                                                           
 143 │ 143 │         )?                                                                               
 144 │ 144 │     )                                                                                    
 145 │ 145 │     (?:\+(?P<local>[a-z0-9]+(?:[-_\.][a-z0-9]+)*))?       # local version                
 146 │ 146 │ """                                                                                      
 147 │ 147 │                                                                                          
 148 │ 148 │ VERSION_PATTERN = _VERSION_PATTERN                                                       
 149 │ 149 │ """                                                                                      
 150 │ 150 │ A string containing the regular expression used to match a valid version.                
 151 │ 151 │                                                                                          
 152 │ 152 │ The pattern is not anchored at either end, and is intended for embedding in larger       
 153 │ 153 │ expressions (for example, matching a version number as part of a file name). The         
 154 │ 154 │ regular expression should be compiled with the ``re.VERBOSE`` and ``re.IGNORECASE``      
 155 │ 155 │ flags set.                                                                               
 156 │ 156 │                                                                                          
 157 │ 157 │ :meta hide-value:                                                                        
 158 │ 158 │ """                                                                                      
