 331 │ 331 │ class DdsImageFile(ImageFile.ImageFile):                                                                                    
 332 │ 332 │     format = "DDS"                                                                                                          
 333 │ 333 │     format_description = "DirectDraw Surface"                                                                               
 334 │ 334 │                                                                                                                             
 335 │ 335 │     def _open(self) -> None:                                                                                                
 336 │ 336 │         if not _accept(self.fp.read(4)):                                                                                    
 337 │ 337 │             msg = "not a DDS file"                                                                                          
 338 │ 338 │             raise SyntaxError(msg)                                                                                          
 339 │ 339 │         (header_size,) = struct.unpack("<I", self.fp.read(4))                                                               
 340 │ 340 │         if header_size != 124:                                                                                              
 341 │ 341 │             msg = f"Unsupported header size {repr(header_size)}"                                                            
 342 │ 342 │             raise OSError(msg)                                                                                              
 343 │ 343 │         header_bytes = self.fp.read(header_size - 4)                                                                        
 344 │ 344 │         if len(header_bytes) != 120:                                                                                        
 345 │ 345 │             msg = f"Incomplete header: {len(header_bytes)} bytes"                                                           
 346 │ 346 │             raise OSError(msg)                                                                                              
 347 │ 347 │         header = io.BytesIO(header_bytes)                                                                                   
 348 │ 348 │                                                                                                                             
