 143 │ 143 │ def get_win_folder_from_env_vars(csidl_name: str) -> str:                                                               
 144 │ 144 │     """Get folder from environment variables."""                                                                        
 145 │ 145 │     result = get_win_folder_if_csidl_name_not_env_var(csidl_name)                                                       
 146 │ 146 │     if result is not None:                                                                                              
 147 │ 147 │         return result                                                                                                   
 148 │ 148 │                                                                                                                         
 149 │ 149 │     env_var_name = {                                                                                                    
 150 │ 150 │         "CSIDL_APPDATA": "APPDATA",                                                                                     
 151 │ 151 │         "CSIDL_COMMON_APPDATA": "ALLUSERSPROFILE",                                                                      
 152 │ 152 │         "CSIDL_LOCAL_APPDATA": "LOCALAPPDATA",                                                                          
 153 │ 153 │     }.get(csidl_name)                                                                                                   
 154 │ 154 │     if env_var_name is None:                                                                                            
 155 │ 155 │         msg = f"Unknown CSIDL name: {csidl_name}"                                                                       
 156 │ 156 │         raise ValueError(msg)                                                                                           
 157 │ 157 │     result = os.environ.get(env_var_name)                                                                               
 158 │ 158 │     if result is None:                                                                                                  
 159 │ 159 │         msg = f"Unset environment variable: {env_var_name}"                                                             
 160 │ 160 │         raise ValueError(msg)                                                                                           
 161 │ 161 │     return result                                                                                                       
 162 │ 162 │                                                                                                                         
 163 │ 163 │                                                                                                                         
 164 │ 164 │ def get_win_folder_if_csidl_name_not_env_var(csidl_name: str) -> str | None:                                            
 165 │ 165 │     """Get a folder for a CSIDL name that does not exist as an environment variable."""                                 
 166 │ 166 │     if csidl_name == "CSIDL_PERSONAL":                                                                                  
 167 │ 167 │         return os.path.join(os.path.normpath(os.environ["USERPROFILE"]), "Documents")  # noqa: PTH118                   
 168 │ 168 │                                                                                                                         
 169 │ 169 │     if csidl_name == "CSIDL_DOWNLOADS":                                                                                 
 170 │ 170 │         return os.path.join(os.path.normpath(os.environ["USERPROFILE"]), "Downloads")  # noqa: PTH118                   
 171 │ 171 │                                                                                                                         
 172 │ 172 │     if csidl_name == "CSIDL_MYPICTURES":                                                                                
 173 │ 173 │         return os.path.join(os.path.normpath(os.environ["USERPROFILE"]), "Pictures")  # noqa: PTH118                    
 174 │ 174 │                                                                                                                         
 175 │ 175 │     if csidl_name == "CSIDL_MYVIDEO":                                                                                   
 176 │ 176 │         return os.path.join(os.path.normpath(os.environ["USERPROFILE"]), "Videos")  # noqa: PTH118                      
 177 │ 177 │                                                                                                                         
 178 │ 178 │     if csidl_name == "CSIDL_MYMUSIC":                                                                                   
 179 │ 179 │         return os.path.join(os.path.normpath(os.environ["USERPROFILE"]), "Music")  # noqa: PTH118                       
 180 │ 180 │     return None                                                                                                         
 181 │ 181 │                                                                                                                         
 182 │ 182 │                                                                                                                         
 183 │ 183 │ def get_win_folder_from_registry(csidl_name: str) -> str:                                                               
 184 │ 184 │     """                                                                                                                 
 185 │ 185 │     Get folder from the registry.                                                                                       
 186 │ 186 │                                                                                                                         
 187 │ 187 │     This is a fallback technique at best. I'm not sure if using the registry for these guarantees us the correct answer 
 188 │ 188 │     for all CSIDL_* names.                                                                                              
 189 │ 189 │                                                                                                                         
 190 │ 190 │     """                                                                                                                 
 191 │ 191 │     shell_folder_name = {                                                                                               
 192 │ 192 │         "CSIDL_APPDATA": "AppData",                                                                                     
 193 │ 193 │         "CSIDL_COMMON_APPDATA": "Common AppData",                                                                       
 194 │ 194 │         "CSIDL_LOCAL_APPDATA": "Local AppData",                                                                         
 195 │ 195 │         "CSIDL_PERSONAL": "Personal",                                                                                   
 196 │ 196 │         "CSIDL_DOWNLOADS": "{374DE290-123F-4565-9164-39C4925E467B}",                                                    
 197 │ 197 │         "CSIDL_MYPICTURES": "My Pictures",                                                                              
 198 │ 198 │         "CSIDL_MYVIDEO": "My Video",                                                                                    
 199 │ 199 │         "CSIDL_MYMUSIC": "My Music",                                                                                    
 200 │ 200 │     }.get(csidl_name)                                                                                                   
 201 │ 201 │     if shell_folder_name is None:                                                                                       
 202 │ 202 │         msg = f"Unknown CSIDL name: {csidl_name}"                                                                       
 203 │ 203 │         raise ValueError(msg)                                                                                           
 204 │ 204 │     if sys.platform != "win32":  # only needed for mypy type checker to know that this code runs only on Windows        
 205 │ 205 │         raise NotImplementedError                                                                                       
 206 │ 206 │     import winreg  # noqa: PLC0415                                                                                      
 207 │ 207 │                                                                                                                         
 208 │ 208 │     key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersionxplorer\Shell Folders") 
 209 │ 209 │     directory, _ = winreg.QueryValueEx(key, shell_folder_name)                                                          
 210 │ 210 │     return str(directory)                                                                                               
 211 │ 211 │                                                                                                                         
 212 │ 212 │                                                                                                                         
 213 │ 213 │ def get_win_folder_via_ctypes(csidl_name: str) -> str:                                                                  
 214 │ 214 │     """Get folder with ctypes."""                                                                                       
 215 │ 215 │     # There is no 'CSIDL_DOWNLOADS'.                                                                                    
 216 │ 216 │     # Use 'CSIDL_PROFILE' (40) and append the default folder 'Downloads' instead.                                       
 217 │ 217 │     # https://learn.microsoft.com/en-us/windows/win32/shell/knownfolderid                                               
 218 │ 218 │                                                                                                                         
 219 │ 219 │     import ctypes  # noqa: PLC0415                                                                                      
 220 │ 220 │                                                                                                                         
 221 │ 221 │     csidl_const = {                                                                                                     
 222 │ 222 │         "CSIDL_APPDATA": 26,                                                                                            
 223 │ 223 │         "CSIDL_COMMON_APPDATA": 35,                                                                                     
 224 │ 224 │         "CSIDL_LOCAL_APPDATA": 28,                                                                                      
 225 │ 225 │         "CSIDL_PERSONAL": 5,                                                                                            
 226 │ 226 │         "CSIDL_MYPICTURES": 39,                                                                                         
 227 │ 227 │         "CSIDL_MYVIDEO": 14,                                                                                            
 228 │ 228 │         "CSIDL_MYMUSIC": 13,                                                                                            
 229 │ 229 │         "CSIDL_DOWNLOADS": 40,                                                                                          
 230 │ 230 │         "CSIDL_DESKTOPDIRECTORY": 16,                                                                                   
 231 │ 231 │     }.get(csidl_name)                                                                                                   
 232 │ 232 │     if csidl_const is None:                                                                                             
 233 │ 233 │         msg = f"Unknown CSIDL name: {csidl_name}"                                                                       
 234 │ 234 │         raise ValueError(msg)                                                                                           
 235 │ 235 │                                                                                                                         
 236 │ 236 │     buf = ctypes.create_unicode_buffer(1024)                                                                            
 237 │ 237 │     windll = getattr(ctypes, "windll")  # noqa: B009 # using getattr to avoid false positive with mypy type checker     
 238 │ 238 │     windll.shell32.SHGetFolderPathW(None, csidl_const, None, 0, buf)                                                    
 239 │ 239 │                                                                                                                         
 240 │ 240 │     # Downgrade to short path name if it has high-bit chars.                                                            
 241 │ 241 │     if any(ord(c) > 255 for c in buf):  # noqa: PLR2004                                                                 
 242 │ 242 │         buf2 = ctypes.create_unicode_buffer(1024)                                                                       
 243 │ 243 │         if windll.kernel32.GetShortPathNameW(buf.value, buf2, 1024):                                                    
 244 │ 244 │             buf = buf2                                                                                                  
 245 │ 245 │                                                                                                                         
 246 │ 246 │     if csidl_name == "CSIDL_DOWNLOADS":                                                                                 
 247 │ 247 │         return os.path.join(buf.value, "Downloads")  # noqa: PTH118                                                     
 248 │ 248 │                                                                                                                         
 249 │ 249 │     return buf.value                                                                                                    
 250 │ 250 │                                                                                                                         
 251 │ 251 │                                                                                                                         
 252 │ 252 │ def _pick_get_win_folder() -> Callable[[str], str]:                                                                     
 253 │ 253 │     try:                                                                                                                
 254 │ 254 │         import ctypes  # noqa: PLC0415                                                                                  
 255 │ 255 │     except ImportError:                                                                                                 
 256 │ 256 │         pass                                                                                                            
 257 │ 257 │     else:                                                                                                               
 258 │ 258 │         if hasattr(ctypes, "windll"):                                                                                   
 259 │ 259 │             return get_win_folder_via_ctypes                                                                            
 260 │ 260 │     try:                                                                                                                
 261 │ 261 │         import winreg  # noqa: PLC0415, F401                                                                            
 262 │ 262 │     except ImportError:                                                                                                 
 263 │ 263 │         return get_win_folder_from_env_vars                                                                             
 264 │ 264 │     else:                                                                                                               
 265 │ 265 │         return get_win_folder_from_registry                                                                             
 266 │ 266 │                                                                                                                         
 267 │ 267 │                                                                                                                         
 268 │ 268 │ get_win_folder = lru_cache(maxsize=None)(_pick_get_win_folder())                                                        
 269 │ 269 │                                                                                                                         
 270 │ 270 │ __all__ = [                                                                                                             
 271 │ 271 │     "Windows",                                                                                                          
 272 │ 272 │ ]                                                                                                                       

