 453 │ 439 │ def equalize(image: Image.Image, mask: Image.Image | None = None) -> Image.Image:       
 454 │ 440 │     """                                                                                 
 455 │ 441 │     Equalize the image histogram. This function applies a non-linear                    
 456 │ 442 │     mapping to the input image, in order to create a uniform                            
 457 │ 443 │     distribution of grayscale values in the output image.                               
 458 │ 444 │                                                                                         
 459 │ 445 │     :param image: The image to equalize.                                                
 460 │ 446 │     :param mask: An optional mask.  If given, only the pixels selected by               
 461 │ 447 │                  the mask are included in the analysis.                                 
 462 │ 448 │     :return: An image.                                                                  
 463 │ 449 │     """                                                                                 
 464 │ 450 │     if image.mode == "P":                                                               
 465 │ 451 │         image = image.convert("RGB")                                                    
 466 │ 452 │     h = image.histogram(mask)                                                           
 467 │ 453 │     lut = []                                                                            
 468 │ 454 │     for b in range(0, len(h), 256):                                                     
 469 │ 455 │         histo = [_f for _f in h[b : b + 256] if _f]                                     
 470 │ 456 │         if len(histo) <= 1:                                                             
 471 │ 457 │             lut.extend(list(range(256)))                                                
 472 │ 458 │         else:                                                                           
 473 │ 459 │             step = (functools.reduce(operator.add, histo) - histo[-1]) // 255           
 474 │ 460 │             if not step:                                                                
 475 │ 461 │                 lut.extend(list(range(256)))                                            
 476 │ 462 │             else:                                                                       
 477 │ 463 │                 n = step // 2                                                           
 478 │ 464 │                 for i in range(256):                                                    
 479 │ 465 │                     lut.append(n // step)                                               
 480 │ 466 │                     n = n + h[i + b]                                                    
 481 │ 467 │     return _lut(image, lut)                                                             
