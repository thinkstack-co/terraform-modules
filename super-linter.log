 101 │ 101 │ def _parse_codestream(fp: IO[bytes]) -> tuple[tuple[int, int], str]:                     
 102 │ 102 │     """Parse the JPEG 2000 codestream to extract the size and component                  
 103 │ 103 │     count from the SIZ marker segment, returning a PIL (size, mode) tuple."""            
 104 │ 104 │                                                                                          
 105 │ 105 │     hdr = fp.read(2)                                                                     
 106 │ 106 │     lsiz = _binary.i16be(hdr)                                                            
 107 │ 107 │     siz = hdr + fp.read(lsiz - 2)                                                        
 108 │ 108 │     lsiz, rsiz, xsiz, ysiz, xosiz, yosiz, _, _, _, _, csiz = struct.unpack_from(         
 109 │ 109 │         ">HHIIIIIIIIH", siz                                                              
 110 │ 110 │     )                                                                                    
 111 │ 111 │                                                                                          
 112 │ 112 │     size = (xsiz - xosiz, ysiz - yosiz)                                                  
 113 │ 113 │     if csiz == 1:                                                                        
 114 │ 114 │         ssiz = struct.unpack_from(">B", siz, 38)                                         
 115 │ 115 │         if (ssiz[0] & 0x7F) + 1 > 8:                                                     
 116 │ 116 │             mode = "I;16"                                                                
 117 │ 117 │         else:                                                                            
 118 │ 118 │             mode = "L"                                                                   
 119 │ 119 │     elif csiz == 2:                                                                      
 120 │ 120 │         mode = "LA"                                                                      
 121 │ 121 │     elif csiz == 3:                                                                      
 122 │ 122 │         mode = "RGB"                                                                     
 123 │ 123 │     elif csiz == 4:                                                                      
 124 │ 124 │         mode = "RGBA"                                                                    
 125 │ 125 │     else:                                                                                
 126 │ 126 │         msg = "unable to determine J2K image mode"                                       
 127 │ 127 │         raise SyntaxError(msg)                                                           
 128 │ 128 │                                                                                          
 129 │ 129 │     return size, mode                                                                    
 130 │ 130 │                                                                                          
 131 │ 131 │                                                                                          
 132 │ 132 │ def _res_to_dpi(num: int, denom: int, exp: int) -> float | None:                         
 133 │ 133 │     """Convert JPEG2000's (numerator, denominator, exponent-base-10) resolution,         
 134 │ 134 │     calculated as (num / denom) * 10^exp and stored in dots per meter,                   
 135 │ 135 │     to floating-point dots per inch."""                                                  
 136 │ 136 │     if denom == 0:                                                                       
 137 │ 137 │         return None                                                                      
 138 │ 138 │     return (254 * num * (10**exp)) / (10000 * denom)                                     
 139 │ 139 │                                                                                          
