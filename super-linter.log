 103 │ 103 │     def _string_permute(self, pattern: str, permutation: list[int]) -> str:             
 104 │ 104 │         """string_permute takes a pattern and a permutation and returns the             
 105 │ 105 │         string permuted according to the permutation list.                              
 106 │ 106 │         """                                                                             
 107 │ 107 │         assert len(permutation) == 9                                                    
 108 │ 108 │         return "".join(pattern[p] for p in permutation)                                 
