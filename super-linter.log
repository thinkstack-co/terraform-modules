 132 │ 132 │         if "N" in options:                                                              
 133 │ 133 │             n = len(patterns)                                                           
 134 │ 134 │             for pattern, res in patterns[:n]:                                           
 135 │ 135 │                 # Swap 0 and 1                                                          
 136 │ 136 │                 pattern = pattern.replace("0", "Z").replace("1", "0").replace("Z", "1") 
 137 │ 137 │                 res = 1 - int(res)                                                      
 138 │ 138 │                 patterns.append((pattern, res))                                         
