 317 │ 317 │     def get_verify_command(self, signature_filename, data_filename,                                 
 318 │ 318 │                            keystore=None):                                                          
 319 │ 319 │         """                                                                                         
 320 │ 320 │         Return a suitable command for verifying a file.                                             
 321 │ 321 │                                                                                                     
 322 │ 322 │         :param signature_filename: The pathname to the file containing the                          
 323 │ 323 │                                    signature.                                                       
 324 │ 324 │         :param data_filename: The pathname to the file containing the                               
 325 │ 325 │                               signed data.                                                          
 326 │ 326 │         :param keystore: The path to a directory which contains the keys                            
 327 │ 327 │                          used in verification. If not specified, the                                
 328 │ 328 │                          instance's ``gpg_home`` attribute is used instead.                         
 329 │ 329 │         :return: The verifying command as a list suitable to be                                     
 330 │ 330 │                  passed to :class:`subprocess.Popen`.                                               
 331 │ 331 │         """                                                                                         
 332 │ 332 │         cmd = [self.gpg, '--status-fd', '2', '--no-tty']                                            
 333 │ 333 │         if keystore is None:                                                                        
 334 │ 334 │             keystore = self.gpg_home                                                                
 335 │ 335 │         if keystore:                                                                                
 336 │ 336 │             cmd.extend(['--homedir', keystore])                                                     
 337 │ 337 │         cmd.extend(['--verify', signature_filename, data_filename])                                 
 338 │ 338 │         logger.debug('invoking: %s', ' '.join(cmd))                                                 
 339 │ 339 │         return cmd                                                                                  
 340 │ 340 │                                                                                                     
 341 │ 341 │     def verify_signature(self, signature_filename, data_filename,                                   
 342 │ 342 │                          keystore=None):                                                            
 343 │ 343 │         """                                                                                         
 344 │ 344 │         Verify a signature for a file.                                                              
 345 │ 345 │                                                                                                     
 346 │ 346 │         :param signature_filename: The pathname to the file containing the                          
 347 │ 347 │                                    signature.                                                       
 348 │ 348 │         :param data_filename: The pathname to the file containing the                               
 349 │ 349 │                               signed data.                                                          
 350 │ 350 │         :param keystore: The path to a directory which contains the keys                            
 351 │ 351 │                          used in verification. If not specified, the                                
 352 │ 352 │                          instance's ``gpg_home`` attribute is used instead.                         
 353 │ 353 │         :return: True if the signature was verified, else False.                                    
 354 │ 354 │         """                                                                                         
 355 │ 355 │         if not self.gpg:                                                                            
 356 │ 356 │             raise DistlibException('verification unavailable because gpg '                          
 357 │ 357 │                                    'unavailable')                                                   
 358 │ 358 │         cmd = self.get_verify_command(signature_filename, data_filename,                            
 359 │ 359 │                                       keystore)                                                     
 360 │ 360 │         rc, stdout, stderr = self.run_command(cmd)                                                  
 361 │ 361 │         if rc not in (0, 1):                                                                        
 362 │ 362 │             raise DistlibException('verify command failed with error code %s' % rc)                 
 363 │ 363 │         return rc == 0                                                                              
 364 │ 364 │                                                                                                     
 365 │ 365 │     def download_file(self, url, destfile, digest=None, reporthook=None):                           
 366 │ 366 │         """                                                                                         
 367 │ 367 │         This is a convenience method for downloading a file from an URL.                            
 368 │ 368 │         Normally, this will be a file from the index, though currently                              
 369 │ 369 │         no check is made for this (i.e. a file can be downloaded from                               
 370 │ 370 │         anywhere).                                                                                  
 371 │ 371 │                                                                                                     
 372 │ 372 │         The method is just like the :func:`urlretrieve` function in the                             
 373 │ 373 │         standard library, except that it allows digest computation to be                            
 374 │ 374 │         done during download and checking that the downloaded data                                  
 375 │ 375 │         matched any expected value.                                                                 
 376 │ 376 │                                                                                                     
 377 │ 377 │         :param url: The URL of the file to be downloaded (assumed to be                             
 378 │ 378 │                     available via an HTTP GET request).                                             
 379 │ 379 │         :param destfile: The pathname where the downloaded file is to be                            
 380 │ 380 │                          saved.                                                                     
 381 │ 381 │         :param digest: If specified, this must be a (hasher, value)                                 
 382 │ 382 │                        tuple, where hasher is the algorithm used (e.g.                              
 383 │ 383 │                        ``'md5'``) and ``value`` is the expected value.                              
 384 │ 384 │         :param reporthook: The same as for :func:`urlretrieve` in the                               
 385 │ 385 │                            standard library.                                                        
 386 │ 386 │         """                                                                                         
 387 │ 387 │         if digest is None:                                                                          
 388 │ 388 │             digester = None                                                                         
 389 │ 389 │             logger.debug('No digest specified')                                                     
 390 │ 390 │         else:                                                                                       
 391 │ 391 │             if isinstance(digest, (list, tuple)):                                                   
 392 │ 392 │                 hasher, digest = digest                                                             
 393 │ 393 │             else:                                                                                   
 394 │ 394 │                 hasher = 'md5'                                                                      
 395 │ 395 │             digester = getattr(hashlib, hasher)()                                                   
 396 │ 396 │             logger.debug('Digest specified: %s' % digest)                                           
 397 │ 397 │         # The following code is equivalent to urlretrieve.                                          
 398 │ 398 │         # We need to do it this way so that we can compute the                                      
 399 │ 399 │         # digest of the file as we go.                                                              
 400 │ 400 │         with open(destfile, 'wb') as dfp:                                                           
 401 │ 401 │             # addinfourl is not a context manager on 2.x                                            
 402 │ 402 │             # so we have to use try/finally                                                         
 403 │ 403 │             sfp = self.send_request(Request(url))                                                   
 404 │ 404 │             try:                                                                                    
 405 │ 405 │                 headers = sfp.info()                                                                
 406 │ 406 │                 blocksize = 8192                                                                    
 407 │ 407 │                 size = -1                                                                           
 408 │ 408 │                 read = 0                                                                            
 409 │ 409 │                 blocknum = 0                                                                        
 410 │ 410 │                 if "content-length" in headers:                                                     
 411 │ 411 │                     size = int(headers["Content-Length"])                                           
 412 │ 412 │                 if reporthook:                                                                      
 413 │ 413 │                     reporthook(blocknum, blocksize, size)                                           
 414 │ 414 │                 while True:                                                                         
 415 │ 415 │                     block = sfp.read(blocksize)                                                     
 416 │ 416 │                     if not block:                                                                   
 417 │ 417 │                         break                                                                       
 418 │ 418 │                     read += len(block)                                                              
 419 │ 419 │                     dfp.write(block)                                                                
 420 │ 420 │                     if digester:                                                                    
 421 │ 421 │                         digester.update(block)                                                      
 422 │ 422 │                     blocknum += 1                                                                   
 423 │ 423 │                     if reporthook:                                                                  
 424 │ 424 │                         reporthook(blocknum, blocksize, size)                                       
 425 │ 425 │             finally:                                                                                
 426 │ 426 │                 sfp.close()                                                                         
 427 │ 427 │                                                                                                     
 428 │ 428 │         # check that we got the whole file, if we can                                               
 429 │ 429 │         if size >= 0 and read < size:                                                               
 430 │ 430 │             raise DistlibException(                                                                 
 431 │ 431 │                 'retrieval incomplete: got only %d out of %d bytes'                                 
 432 │ 432 │                 % (read, size))                                                                     
 433 │ 433 │         # if we have a digest, it must match.                                                       
 434 │ 434 │         if digester:                                                                                
 435 │ 435 │             actual = digester.hexdigest()                                                           
 436 │ 436 │             if digest != actual:                                                                    
 437 │ 437 │                 raise DistlibException('%s digest mismatch for %s: expected '                       
 438 │ 438 │                                        '%s, got %s' % (hasher, destfile,                            
 439 │ 439 │                                                        digest, actual))                             
 440 │ 440 │             logger.debug('Digest verified: %s', digest)                                             
 441 │ 441 │                                                                                                     
 442 │ 442 │     def send_request(self, req):                                                                    
 443 │ 443 │         """                                                                                         
 444 │ 444 │         Send a standard library :class:`Request` to PyPI and return its                             
 445 │ 445 │         response.                                                                                   
 446 │ 446 │                                                                                                     
 447 │ 447 │         :param req: The request to send.                                                            
 448 │ 448 │         :return: The HTTP response from PyPI (a standard library HTTPResponse).                     
 449 │ 449 │         """                                                                                         
 450 │ 450 │         handlers = []                                                                               
 451 │ 451 │         if self.password_handler:                                                                   
 452 │ 452 │             handlers.append(self.password_handler)                                                  
 453 │ 453 │         if self.ssl_verifier:                                                                       
 454 │ 454 │             handlers.append(self.ssl_verifier)                                                      
 455 │ 455 │         opener = build_opener(*handlers)                                                            
 456 │ 456 │         return opener.open(req)                                                                     
 457 │ 457 │                                                                                                     
 458 │ 458 │     def encode_request(self, fields, files):                                                        
 459 │ 459 │         """                                                                                         
 460 │ 460 │         Encode fields and files for posting to an HTTP server.                                      
 461 │ 461 │                                                                                                     
 462 │ 462 │         :param fields: The fields to send as a list of (fieldname, value)                           
 463 │ 463 │                        tuples.                                                                      
 464 │ 464 │         :param files: The files to send as a list of (fieldname, filename,                          
 465 │ 465 │                       file_bytes) tuple.                                                            
 466 │ 466 │         """                                                                                         
 467 │ 467 │         # Adapted from packaging, which in turn was adapted from                                    
 468 │ 468 │         # http://code.activestate.com/recipes/146306                                                
 469 │ 469 │                                                                                                     
 470 │ 470 │         parts = []                                                                                  
 471 │ 471 │         boundary = self.boundary                                                                    
 472 │ 472 │         for k, values in fields:                                                                    
 473 │ 473 │             if not isinstance(values, (list, tuple)):                                               
 474 │ 474 │                 values = [values]                                                                   
 475 │ 475 │                                                                                                     
 476 │ 476 │             for v in values:                                                                        
 477 │ 477 │                 parts.extend((                                                                      
 478 │ 478 │                     b'--' + boundary,                                                               
 479 │ 479 │                     ('Content-Disposition: form-data; name="%s"' %                                  
 480 │ 480 │                      k).encode('utf-8'),                                                            
 481 │ 481 │                     b'',                                                                            
 482 │ 482 │                     v.encode('utf-8')))                                                             
 483 │ 483 │         for key, filename, value in files:                                                          
 484 │ 484 │             parts.extend((                                                                          
 485 │ 485 │                 b'--' + boundary,                                                                   
 486 │ 486 │                 ('Content-Disposition: form-data; name="%s"; filename="%s"' %                       
 487 │ 487 │                  (key, filename)).encode('utf-8'),                                                  
 488 │ 488 │                 b'',                                                                                
 489 │ 489 │                 value))                                                                             
 490 │ 490 │                                                                                                     
 491 │ 491 │         parts.extend((b'--' + boundary + b'--', b''))                                               
 492 │ 492 │                                                                                                     
 493 │ 493 │         body = b'
'.join(parts)                                                                  
 494 │ 494 │         ct = b'multipart/form-data; boundary=' + boundary                                           
 495 │ 495 │         headers = {                                                                                 
 496 │ 496 │             'Content-type': ct,                                                                     
 497 │ 497 │             'Content-length': str(len(body))                                                        
 498 │ 498 │         }                                                                                           
 499 │ 499 │         return Request(self.url, body, headers)                                                     
 500 │ 500 │                                                                                                     
 501 │ 501 │     def search(self, terms, operator=None):  # pragma: no cover                                     
 502 │ 502 │         if isinstance(terms, string_types):                                                         
 503 │ 503 │             terms = {'name': terms}                                                                 
 504 │ 504 │         rpc_proxy = ServerProxy(self.url, timeout=3.0)                                              
 505 │ 505 │         try:                                                                                        
 506 │ 506 │             return rpc_proxy.search(terms, operator or 'and')                                       
 507 │ 507 │         finally:                                                                                    
 508 │ 508 │             rpc_proxy('close')()                                                                    

