 270 │ 256 │     image: Image.Image, size: tuple[int, int], method: int = Image.Resampling.BICUBIC   
 271 │ 257 │ ) -> Image.Image:                                                                       
 272 │ 258 │     """                                                                                 
 273 │ 259 │     Returns a resized version of the image, set to the maximum width and height         
 274 │ 260 │     within the requested size, while maintaining the original aspect ratio.             
 275 │ 261 │                                                                                         
 276 │ 262 │     :param image: The image to resize.                                                  
 277 │ 263 │     :param size: The requested output size in pixels, given as a                        
 278 │ 264 │                  (width, height) tuple.                                                 
 279 │ 265 │     :param method: Resampling method to use. Default is                                 
 280 │ 266 │                    :py:attr:`~PIL.Image.Resampling.BICUBIC`.                            
 281 │ 267 │                    See :ref:`concept-filters`.                                          
 282 │ 268 │     :return: An image.                                                                  
 283 │ 269 │     """                                                                                 
 284 │ 270 │                                                                                         
 285 │ 271 │     im_ratio = image.width / image.height                                               
 286 │ 272 │     dest_ratio = size[0] / size[1]                                                      
 287 │ 273 │                                                                                         
 288 │ 274 │     if im_ratio != dest_ratio:                                                          
 289 │ 275 │         if im_ratio > dest_ratio:                                                       
 290 │ 276 │             new_height = round(image.height / image.width * size[0])                    
