 36 │ 36 │                                                                                        
 37 │ 37 │                                                                                        
 38 │ 38 │ class MultiByteCharSetProber(CharSetProber):                                           
 39 │ 39 │     """                                                                                
 40 │ 40 │     MultiByteCharSetProber                                                             
 41 │ 41 │     """                                                                                
 42 │ 42 │                                                                                        
 43 │ 43 │     def __init__(self, lang_filter: LanguageFilter = LanguageFilter.NONE) -> None:     
 44 │ 44 │         super().__init__(lang_filter=lang_filter)                                      
 45 │ 45 │         self.distribution_analyzer: Optional[CharDistributionAnalysis] = None          
 46 │ 46 │         self.coding_sm: Optional[CodingStateMachine] = None                            
 47 │ 47 │         self._last_char = bytearray(b"␀␀")                                           
 48 │ 48 │                                                                                        
 49 │ 49 │     def reset(self) -> None:                                                           
 50 │ 50 │         super().reset()                                                                
 51 │ 51 │         if self.coding_sm:                                                             
 52 │ 52 │             self.coding_sm.reset()                                                     
 53 │ 53 │         if self.distribution_analyzer:                                                 
 54 │ 54 │             self.distribution_analyzer.reset()                                         
 55 │ 55 │         self._last_char = bytearray(b"␀␀")                                           
 56 │ 56 │                                                                                        
 57 │ 57 │     def feed(self, byte_str: Union[bytes, bytearray]) -> ProbingState:                 
 58 │ 58 │         assert self.coding_sm is not None                                              
 59 │ 59 │         assert self.distribution_analyzer is not None                                  
 60 │ 60 │                                                                                        
 61 │ 61 │         for i, byte in enumerate(byte_str):                                            
 62 │ 62 │             coding_state = self.coding_sm.next_state(byte)                             
 63 │ 63 │             if coding_state == MachineState.ERROR:                                     
 64 │ 64 │                 self.logger.debug(                                                     
 65 │ 65 │                     "%s %s prober hit error at byte %s",                               
 66 │ 66 │                     self.charset_name,                                                 
 67 │ 67 │                     self.language,                                                     
 68 │ 68 │                     i,                                                                 
 69 │ 69 │                 )                                                                      
 70 │ 70 │                 self._state = ProbingState.NOT_ME                                      
 71 │ 71 │                 break                                                                  
 72 │ 72 │             if coding_state == MachineState.ITS_ME:                                    
 73 │ 73 │                 self._state = ProbingState.FOUND_IT                                    
 74 │ 74 │                 break                                                                  
 75 │ 75 │             if coding_state == MachineState.START:                                     
 76 │ 76 │                 char_len = self.coding_sm.get_current_charlen()                        
 77 │ 77 │                 if i == 0:                                                             
 78 │ 78 │                     self._last_char[1] = byte                                          
 79 │ 79 │                     self.distribution_analyzer.feed(self._last_char, char_len)         
 80 │ 80 │                 else:                                                                  
 81 │ 81 │                     self.distribution_analyzer.feed(byte_str[i - 1 : i + 1], char_len) 
 82 │ 82 │                                                                                        
 83 │ 83 │         self._last_char[0] = byte_str[-1]                                              
 84 │ 84 │                                                                                        
 85 │ 85 │         if self.state == ProbingState.DETECTING:                                       
 86 │ 86 │             if self.distribution_analyzer.got_enough_data() and (                      
 87 │ 87 │                 self.get_confidence() > self.SHORTCUT_THRESHOLD                        
 88 │ 88 │             ):                                                                         
 89 │ 89 │                 self._state = ProbingState.FOUND_IT                                    
 90 │ 90 │                                                                                        
 91 │ 91 │         return self.state                                                              
 92 │ 92 │                                                                                        
 93 │ 93 │     def get_confidence(self) -> float:                                                 
 94 │ 94 │         assert self.distribution_analyzer is not None                                  
 95 │ 95 │         return self.distribution_analyzer.get_confidence()                             

