Check: CKV_AZURE_50: "Ensure Virtual Machine Extensions are not Installed"
	FAILED for resource: azurerm_windows_virtual_machine.session_host[0]
	File: /modules/azure/terraform_modules/cmmc-enclave-template/modules/08-session-hosts/main.tf:36-76
	Guide: https://docs.prismacloud.io/en/enterprise-edition/policy-reference/azure-policies/azure-general-policies/bc-azr-general-14

		36 | resource "azurerm_windows_virtual_machine" "session_host" {
		37 |   count               = var.host_count
		38 |   name                = "${var.customer_name}-avd-${format("%02d", count.index + 1)}"
		39 |   location            = var.location
		40 |   resource_group_name = var.resource_group_name
		41 |   size                = var.vm_size
		42 |   admin_username      = var.admin_username
		43 |   admin_password      = var.admin_password
		44 |   tags                = var.tags
		45 | 
		46 |   network_interface_ids = [azurerm_network_interface.session_host[count.index].id]
		47 | 
		48 |   # Trusted Launch (UEFI + vTPM)
		49 |   vtpm_enabled        = true
		50 |   secure_boot_enabled = true
		51 | 
		52 |   os_disk {
		53 |     caching              = "ReadWrite"
		54 |     storage_account_type = var.os_disk_type
		55 |     disk_size_gb         = 128
		56 |   }
		57 | 
		58 |   source_image_id = "${var.gallery_image_id}/versions/${var.image_version}"
		59 | 
		60 |   # Windows Client licensing for AVD
		61 |   license_type = "Windows_Client"
		62 | 
		63 |   identity {
		64 |     type = "SystemAssigned"
		65 |   }
		66 | 
		67 |   # Why: admin_password is set at VM creation but is expected to drift over
		68 |   # time (rotated out of band via Azure's reset-password flow, manually, or
		69 |   # by a separate rotation process). The azurerm provider treats any change
		70 |   # to admin_password as forcing replacement, which would destroy the VM and
		71 |   # all its extensions. Ignore drift so password rotation does not destroy
		72 |   # session hosts.
		73 |   lifecycle {
		74 |     ignore_changes = [admin_password]
		75 |   }
		76 | }

