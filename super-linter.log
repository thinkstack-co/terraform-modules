 166 │ 154 │             if 0xD8 <= pair[0] <= 0xDB:                                        
 167 │ 155 │                 self.first_half_surrogate_pair_detected_16be = True            
 168 │ 156 │             elif 0xDC <= pair[0] <= 0xDF:                                      
 169 │ 157 │                 self.invalid_utf16be = True                                    
 170 │ 158 │         else:                                                                  
 171 │ 159 │             if 0xDC <= pair[0] <= 0xDF:                                        
 172 │ 160 │                 self.first_half_surrogate_pair_detected_16be = False           
 173 │ 161 │             else:                                                              
 174 │ 162 │                 self.invalid_utf16be = True                                    
 175 │ 163 │                                                                                
 176 │ 164 │         if not self.first_half_surrogate_pair_detected_16le:                   
 177 │ 165 │             if 0xD8 <= pair[1] <= 0xDB:                                        
 178 │ 166 │                 self.first_half_surrogate_pair_detected_16le = True            
 179 │ 167 │             elif 0xDC <= pair[1] <= 0xDF:                                      
 180 │ 168 │                 self.invalid_utf16le = True                                    
 181 │ 169 │         else:                                                                  
 182 │ 170 │             if 0xDC <= pair[1] <= 0xDF:                                        
 183 │ 171 │                 self.first_half_surrogate_pair_detected_16le = False           
 184 │ 172 │             else:                                                              
 185 │ 173 │                 self.invalid_utf16le = True                                    
