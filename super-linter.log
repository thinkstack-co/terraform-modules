 252 │ 252 │             msg = "Wrong size operator file!"                                           
 253 │ 253 │             raise Exception(msg)                                                        
 254 │ 254 │                                                                                         
 255 │ 255 │     def save_lut(self, filename: str) -> None:                                          
 256 │ 256 │         """Save an operator to an mrl file"""                                           
 257 │ 257 │         if self.lut is None:                                                            
 258 │ 258 │             msg = "No operator loaded"                                                  
 259 │ 259 │             raise Exception(msg)                                                        
 260 │ 260 │         with open(filename, "wb") as f:                                                 
 261 │ 261 │             f.write(self.lut)                                                           
