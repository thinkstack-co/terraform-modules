 156 │ 156 │                 raise Exception(msg)                                                    
 157 │ 157 │             options = m.group(1)                                                        
 158 │ 158 │             pattern = m.group(2)                                                        
 159 │ 159 │             result = int(m.group(3))                                                    
 160 │ 160 │                                                                                         
 161 │ 161 │             # Get rid of spaces                                                         
 162 │ 162 │             pattern = pattern.replace(" ", "").replace("
", "")                        
 163 │ 163 │                                                                                         
 164 │ 164 │             patterns += self._pattern_permute(pattern, options, result)                 
 165 │ 165 │                                                                                         
 166 │ 166 │         # compile the patterns into regular expressions for speed                       
 167 │ 167 │         compiled_patterns = []                                                          
 168 │ 168 │         for pattern in patterns:                                                        
 169 │ 169 │             p = pattern[0].replace(".", "X").replace("X", "[01]")                       
 170 │ 170 │             compiled_patterns.append((re.compile(p), pattern[1]))                       
 171 │ 171 │                                                                                         
 172 │ 172 │         # Step through table and find patterns that match.                              
 173 │ 173 │         # Note that all the patterns are searched. The last one                         
 174 │ 174 │         # caught overrides                                                              
 175 │ 175 │         for i in range(LUT_SIZE):                                                       
 176 │ 176 │             # Build the bit pattern                                                     
 177 │ 177 │             bitpattern = bin(i)[2:]                                                     
 178 │ 178 │             bitpattern = ("0" * (9 - len(bitpattern)) + bitpattern)[::-1]               
 179 │ 179 │                                                                                         
 180 │ 180 │             for pattern, r in compiled_patterns:                                        
 181 │ 181 │                 if pattern.match(bitpattern):                                           
 182 │ 182 │                     self.lut[i] = [0, 1][r]                                             
 183 │ 183 │                                                                                         
