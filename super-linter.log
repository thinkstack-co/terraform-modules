 92  │ 92  │         return self._model.language                                                      
 93  │ 93  │                                                                                          
 94  │ 94  │     def feed(self, byte_str: Union[bytes, bytearray]) -> ProbingState:                   
 95  │ 95  │         # TODO: Make filter_international_words keep things in self.alphabet             
 96  │ 96  │         if not self._model.keep_ascii_letters:                                           
 97  │ 97  │             byte_str = self.filter_international_words(byte_str)                         
 98  │ 98  │         else:                                                                            
 99  │ 99  │             byte_str = self.remove_xml_tags(byte_str)                                    
 100 │ 100 │         if not byte_str:                                                                 
 101 │ 101 │             return self.state                                                            
 102 │ 102 │         char_to_order_map = self._model.char_to_order_map                                
 103 │ 103 │         language_model = self._model.language_model                                      
 104 │ 104 │         for char in byte_str:                                                            
 105 │ 105 │             order = char_to_order_map.get(char, CharacterCategory.UNDEFINED)             
 106 │ 106 │             # XXX: This was SYMBOL_CAT_ORDER before, with a value of 250, but            
 107 │ 107 │             #      CharacterCategory.SYMBOL is actually 253, so we use CONTROL           
 108 │ 108 │             #      to make it closer to the original intent. The only difference         
 109 │ 109 │             #      is whether or not we count digits and control characters for          
 110 │ 110 │             #      _total_char purposes.                                                 
 111 │ 111 │             if order < CharacterCategory.CONTROL:                                        
 112 │ 112 │                 self._total_char += 1                                                    
 113 │ 113 │             if order < self.SAMPLE_SIZE:                                                 
 114 │ 114 │                 self._freq_char += 1                                                     
 115 │ 115 │                 if self._last_order < self.SAMPLE_SIZE:                                  
 116 │ 116 │                     self._total_seqs += 1                                                
 117 │ 117 │                     if not self._reversed:                                               
 118 │ 118 │                         lm_cat = language_model[self._last_order][order]                 
 119 │ 119 │                     else:                                                                
 120 │ 120 │                         lm_cat = language_model[order][self._last_order]                 
 121 │ 121 │                     self._seq_counters[lm_cat] += 1                                      
 122 │ 122 │             self._last_order = order                                                     
 123 │ 123 │                                                                                          
 124 │ 124 │         charset_name = self._model.charset_name                                          
 125 │ 125 │         if self.state == ProbingState.DETECTING:                                         
 126 │ 126 │             if self._total_seqs > self.SB_ENOUGH_REL_THRESHOLD:                          
 127 │ 127 │                 confidence = self.get_confidence()                                       
 128 │ 128 │                 if confidence > self.POSITIVE_SHORTCUT_THRESHOLD:                        
 129 │ 129 │                     self.logger.debug(                                                   
 130 │ 130 │                         "%s confidence = %s, we have a winner", charset_name, confidence 
 131 │ 131 │                     )                                                                    
 132 │ 132 │                     self._state = ProbingState.FOUND_IT                                  
 133 │ 133 │                 elif confidence < self.NEGATIVE_SHORTCUT_THRESHOLD:                      
 134 │ 134 │                     self.logger.debug(                                                   
 135 │ 135 │                         "%s confidence = %s, below negative shortcut threshold %s",      
 136 │ 136 │                         charset_name,                                                    
 137 │ 137 │                         confidence,                                                      
 138 │ 138 │                         self.NEGATIVE_SHORTCUT_THRESHOLD,                                
 139 │ 139 │                     )                                                                    
 140 │ 140 │                     self._state = ProbingState.NOT_ME                                    
 141 │ 141 │                                                                                          
 142 │ 142 │         return self.state                                                                
 143 │ 143 │                                                                                          
 144 │ 144 │     def get_confidence(self) -> float:                                                   
 145 │ 145 │         r = 0.01                                                                         
 146 │ 146 │         if self._total_seqs > 0:                                                         
 147 │ 147 │             r = (                                                                        
 148 │ 148 │                 (                                                                        
 149 │ 149 │                     self._seq_counters[SequenceLikelihood.POSITIVE]                      
 150 │ 150 │                     + 0.25 * self._seq_counters[SequenceLikelihood.LIKELY]               
 151 │ 151 │                 )                                                                        
 152 │ 152 │                 / self._total_seqs                                                       
 153 │ 153 │                 / self._model.typical_positive_ratio                                     
 154 │ 154 │             )                                                                            
 155 │ 155 │             # The more control characters (proportionnaly to the size                    
 156 │ 156 │             # of the text), the less confident we become in the current                  
 157 │ 157 │             # charset.                                                                   
 158 │ 158 │             r = r * (self._total_char - self._control_char) / self._total_char           
 159 │ 159 │             r = r * self._freq_char / self._total_char                                   
 160 │ 160 │             if r >= 1.0:                                                                 
 161 │ 161 │                 r = 0.99                                                                 
 162 │ 162 │         return r                                                                         

