 330 │ 330 │ def compatible_tags(                                                                       
 331 │ 331 │     python_version: PythonVersion | None = None,                                           
 332 │ 332 │     interpreter: str | None = None,                                                        
 333 │ 333 │     platforms: Iterable[str] | None = None,                                                
 334 │ 334 │ ) -> Iterator[Tag]:                                                                        
 335 │ 335 │     """                                                                                    
 336 │ 336 │     Yields the sequence of tags that are compatible with a specific version of Python.     
 337 │ 337 │                                                                                            
 338 │ 338 │     The tags consist of:                                                                   
 339 │ 339 │     - py*-none-<platform>                                                                  
 340 │ 340 │     - <interpreter>-none-any  # ... if `interpreter` is provided.                          
 341 │ 341 │     - py*-none-any                                                                         
 342 │ 342 │     """                                                                                    
 343 │ 343 │     if not python_version:                                                                 
 344 │ 344 │         python_version = sys.version_info[:2]                                              
 345 │ 345 │     platforms = list(platforms or platform_tags())                                         
 346 │ 346 │     for version in _py_interpreter_range(python_version):                                  
 347 │ 347 │         for platform_ in platforms:                                                        
 348 │ 348 │             yield Tag(version, "none", platform_)                                          
 349 │ 349 │     if interpreter:                                                                        
 350 │ 350 │         yield Tag(interpreter, "none", "any")                                              
 351 │ 351 │     for version in _py_interpreter_range(python_version):                                  
 352 │ 352 │         yield Tag(version, "none", "any")                                                  
