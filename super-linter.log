 514 │ 500 │ def fit(                                                                                
 515 │ 501 │     image: Image.Image,                                                                 
 516 │ 502 │     size: tuple[int, int],                                                              
 517 │ 503 │     method: int = Image.Resampling.BICUBIC,                                             
 518 │ 504 │     bleed: float = 0.0,                                                                 
 519 │ 505 │     centering: tuple[float, float] = (0.5, 0.5),                                        
 520 │ 506 │ ) -> Image.Image:                                                                       
 521 │ 507 │     """                                                                                 
 522 │ 508 │     Returns a resized and cropped version of the image, cropped to the                  
 523 │ 509 │     requested aspect ratio and size.                                                    
 524 │ 510 │                                                                                         
 525 │ 511 │     This function was contributed by Kevin Cazabon.                                     
 526 │ 512 │                                                                                         
 527 │ 513 │     :param image: The image to resize and crop.                                         
 528 │ 514 │     :param size: The requested output size in pixels, given as a                        
 529 │ 515 │                  (width, height) tuple.                                                 
 530 │ 516 │     :param method: Resampling method to use. Default is                                 
 531 │ 517 │                    :py:attr:`~PIL.Image.Resampling.BICUBIC`.                            
 532 │ 518 │                    See :ref:`concept-filters`.                                          
 533 │ 519 │     :param bleed: Remove a border around the outside of the image from all              
 534 │ 520 │                   four edges. The value is a decimal percentage (use 0.01 for           
 535 │ 521 │                   one percent). The default value is 0 (no border).                     
 536 │ 522 │                   Cannot be greater than or equal to 0.5.                               
 537 │ 523 │     :param centering: Control the cropping position.  Use (0.5, 0.5) for                
 538 │ 524 │                       center cropping (e.g. if cropping the width, take 50% off         
 539 │ 525 │                       of the left side, and therefore 50% off the right side).          
 540 │ 526 │                       (0.0, 0.0) will crop from the top left corner (i.e. if            
 541 │ 527 │                       cropping the width, take all of the crop off of the right         
 542 │ 528 │                       side, and if cropping the height, take all of it off the          
 543 │ 529 │                       bottom).  (1.0, 0.0) will crop from the bottom left               
 544 │ 530 │                       corner, etc. (i.e. if cropping the width, take all of the         
 545 │ 531 │                       crop off the left side, and if cropping the height take           
 546 │ 532 │                       none from the top, and therefore all off the bottom).             
 547 │ 533 │     :return: An image.                                                                  
 548 │ 534 │     """                                                                                 
 549 │ 535 │                                                                                         
 550 │ 536 │     # by Kevin Cazabon, Feb 17/2000                                                     
 551 │ 537 │     # kevin@cazabon.com                                                                 
 552 │ 538 │     # https://www.cazabon.com                                                           
 553 │ 539 │                                                                                         
 554 │ 540 │     centering_x, centering_y = centering                                                
 555 │ 541 │                                                                                         
 556 │ 542 │     if not 0.0 <= centering_x <= 1.0:                                                   
 557 │ 543 │         centering_x = 0.5                                                               
 558 │ 544 │     if not 0.0 <= centering_y <= 1.0:                                                   
 559 │ 545 │         centering_y = 0.5                                                               
 560 │ 546 │                                                                                         
 561 │ 547 │     if not 0.0 <= bleed < 0.5:                                                          
 562 │ 548 │         bleed = 0.0                                                                     
 563 │ 549 │                                                                                         
 564 │ 550 │     # calculate the area to use for resizing and cropping, subtracting                  
 565 │ 551 │     # the 'bleed' around the edges                                                      
 566 │ 552 │                                                                                         
 567 │ 553 │     # number of pixels to trim off on Top and Bottom, Left and Right                    
 568 │ 554 │     bleed_pixels = (bleed * image.size[0], bleed * image.size[1])                       
 569 │ 555 │                                                                                         
 570 │ 556 │     live_size = (                                                                       
 571 │ 557 │         image.size[0] - bleed_pixels[0] * 2,                                            
 572 │ 558 │         image.size[1] - bleed_pixels[1] * 2,                                            
 573 │ 559 │     )                                                                                   
 574 │ 560 │                                                                                         
 575 │ 561 │     # calculate the aspect ratio of the live_size                                       
 576 │ 562 │     live_size_ratio = live_size[0] / live_size[1]                                       
 577 │ 563 │                                                                                         
 578 │ 564 │     # calculate the aspect ratio of the output image                                    
 579 │ 565 │     output_ratio = size[0] / size[1]                                                    
 580 │ 566 │                                                                                         
 581 │ 567 │     # figure out if the sides or top/bottom will be cropped off                         
 582 │ 568 │     if live_size_ratio == output_ratio:                                                 
 583 │ 569 │         # live_size is already the needed ratio                                         
 584 │ 570 │         crop_width = live_size[0]                                                       
 585 │ 571 │         crop_height = live_size[1]                                                      
 586 │ 572 │     elif live_size_ratio >= output_ratio:                                               
 587 │ 573 │         # live_size is wider than what's needed, crop the sides                         
 588 │ 574 │         crop_width = output_ratio * live_size[1]                                        
 589 │ 575 │         crop_height = live_size[1]                                                      
 590 │ 576 │     else:                                                                               
 591 │ 577 │         # live_size is taller than what's needed, crop the top and bottom               
 592 │ 578 │         crop_width = live_size[0]                                                       
 593 │ 579 │         crop_height = live_size[0] / output_ratio                                       
 594 │ 580 │                                                                                         
 595 │ 581 │     # make the crop                                                                     
 596 │ 582 │     crop_left = bleed_pixels[0] + (live_size[0] - crop_width) * centering_x             
 597 │ 583 │     crop_top = bleed_pixels[1] + (live_size[1] - crop_height) * centering_y             
 598 │ 584 │                                                                                         
 599 │ 585 │     crop = (crop_left, crop_top, crop_left + crop_width, crop_top + crop_height)        
 600 │ 586 │                                                                                         
 601 │ 587 │     # resize the image and return it                                                    
 602 │ 588 │     return image.resize(size, method, box=crop)                                         
