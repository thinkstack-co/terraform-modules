 245 │ 245 │     if not post:                                                                                    
 246 │ 246 │         post = ('_',)   # sort before 'a'                                                           
 247 │ 247 │     if not dev:                                                                                     
 248 │ 248 │         dev = ('final',)                                                                            
 249 │ 249 │                                                                                                     
 250 │ 250 │     return epoch, nums, pre, post, dev, local                                                       
 251 │ 251 │                                                                                                     
 252 │ 252 │                                                                                                     
 253 │ 253 │ _normalized_key = _pep_440_key                                                                      
 254 │ 254 │                                                                                                     
 255 │ 255 │                                                                                                     
 256 │ 256 │ class NormalizedVersion(Version):                                                                   
 257 │ 257 │     """A rational version.                                                                          
 258 │ 258 │                                                                                                     
 259 │ 259 │     Good:                                                                                           
 260 │ 260 │         1.2         # equivalent to "1.2.0"                                                         
 261 │ 261 │         1.2.0                                                                                       
 262 │ 262 │         1.2a1                                                                                       
 263 │ 263 │         1.2.3a2                                                                                     
 264 │ 264 │         1.2.3b1                                                                                     
 265 │ 265 │         1.2.3c1                                                                                     
 266 │ 266 │         1.2.3.4                                                                                     
 267 │ 267 │         TODO: fill this out                                                                         
 268 │ 268 │                                                                                                     
 269 │ 269 │     Bad:                                                                                            
 270 │ 270 │         1           # minimum two numbers                                                           
 271 │ 271 │         1.2a        # release level must have a release serial                                      
 272 │ 272 │         1.2.3b                                                                                      
 273 │ 273 │     """                                                                                             
 274 │ 274 │     def parse(self, s):                                                                             
 275 │ 275 │         result = _normalized_key(s)                                                                 
 276 │ 276 │         # _normalized_key loses trailing zeroes in the release                                      
 277 │ 277 │         # clause, since that's needed to ensure that X.Y == X.Y.0 == X.Y.0.0                        
 278 │ 278 │         # However, PEP 440 prefix matching needs it: for example,                                   
 279 │ 279 │         # (~= 1.4.5.0) matches differently to (~= 1.4.5.0.0).                                       
 280 │ 280 │         m = PEP440_VERSION_RE.match(s)      # must succeed                                          
 281 │ 281 │         groups = m.groups()                                                                         
 282 │ 282 │         self._release_clause = tuple(int(v) for v in groups[1].split('.'))                          
 283 │ 283 │         return result                                                                               
 284 │ 284 │                                                                                                     
 285 │ 285 │     PREREL_TAGS = set(['a', 'b', 'c', 'rc', 'dev'])                                                 
 286 │ 286 │                                                                                                     
 287 │ 287 │     @property                                                                                       
 288 │ 288 │     def is_prerelease(self):                                                                        
 289 │ 289 │         return any(t[0] in self.PREREL_TAGS for t in self._parts if t)                              
 290 │ 290 │                                                                                                     
 291 │ 291 │                                                                                                     
 292 │ 292 │ def _match_prefix(x, y):                                                                            
 293 │ 293 │     x = str(x)                                                                                      
 294 │ 294 │     y = str(y)                                                                                      
 295 │ 295 │     if x == y:                                                                                      
 296 │ 296 │         return True                                                                                 
 297 │ 297 │     if not x.startswith(y):                                                                         
 298 │ 298 │         return False                                                                                
 299 │ 299 │     n = len(y)                                                                                      
 300 │ 300 │     return x[n] == '.'                                                                              
 301 │ 301 │                                                                                                     
 302 │ 302 │                                                                                                     
 303 │ 303 │ class NormalizedMatcher(Matcher):                                                                   
 304 │ 304 │     version_class = NormalizedVersion                                                               
 305 │ 305 │                                                                                                     
 306 │ 306 │     # value is either a callable or the name of a method                                            
 307 │ 307 │     _operators = {                                                                                  
 308 │ 308 │         '~=': '_match_compatible',                                                                  
 309 │ 309 │         '<': '_match_lt',                                                                           
 310 │ 310 │         '>': '_match_gt',                                                                           
 311 │ 311 │         '<=': '_match_le',                                                                          
 312 │ 312 │         '>=': '_match_ge',                                                                          
 313 │ 313 │         '==': '_match_eq',                                                                          
 314 │ 314 │         '===': '_match_arbitrary',                                                                  
 315 │ 315 │         '!=': '_match_ne',                                                                          
 316 │ 316 │     }                                                                                               
 317 │ 317 │                                                                                                     
 318 │ 318 │     def _adjust_local(self, version, constraint, prefix):                                           
 319 │ 319 │         if prefix:                                                                                  
 320 │ 320 │             strip_local = '+' not in constraint and version._parts[-1]                              
 321 │ 321 │         else:                                                                                       
 322 │ 322 │             # both constraint and version are                                                       
 323 │ 323 │             # NormalizedVersion instances.                                                          
 324 │ 324 │             # If constraint does not have a local component,                                        
 325 │ 325 │             # ensure the version doesn't, either.                                                   
 326 │ 326 │             strip_local = not constraint._parts[-1] and version._parts[-1]                          
 327 │ 327 │         if strip_local:                                                                             
 328 │ 328 │             s = version._string.split('+', 1)[0]                                                    
 329 │ 329 │             version = self.version_class(s)                                                         
 330 │ 330 │         return version, constraint                                                                  
 331 │ 331 │                                                                                                     
 332 │ 332 │     def _match_lt(self, version, constraint, prefix):                                               
 333 │ 333 │         version, constraint = self._adjust_local(version, constraint, prefix)                       
 334 │ 334 │         if version >= constraint:                                                                   
 335 │ 335 │             return False                                                                            
 336 │ 336 │         release_clause = constraint._release_clause                                                 
 337 │ 337 │         pfx = '.'.join([str(i) for i in release_clause])                                            
 338 │ 338 │         return not _match_prefix(version, pfx)                                                      
 339 │ 339 │                                                                                                     
 340 │ 340 │     def _match_gt(self, version, constraint, prefix):                                               
 341 │ 341 │         version, constraint = self._adjust_local(version, constraint, prefix)                       
 342 │ 342 │         if version <= constraint:                                                                   
 343 │ 343 │             return False                                                                            
 344 │ 344 │         release_clause = constraint._release_clause                                                 
 345 │ 345 │         pfx = '.'.join([str(i) for i in release_clause])                                            
 346 │ 346 │         return not _match_prefix(version, pfx)                                                      
 347 │ 347 │                                                                                                     
 348 │ 348 │     def _match_le(self, version, constraint, prefix):                                               
 349 │ 349 │         version, constraint = self._adjust_local(version, constraint, prefix)                       
 350 │ 350 │         return version <= constraint                                                                
 351 │ 351 │                                                                                                     
 352 │ 352 │     def _match_ge(self, version, constraint, prefix):                                               
 353 │ 353 │         version, constraint = self._adjust_local(version, constraint, prefix)                       
 354 │ 354 │         return version >= constraint                                                                
 355 │ 355 │                                                                                                     
 356 │ 356 │     def _match_eq(self, version, constraint, prefix):                                               
 357 │ 357 │         version, constraint = self._adjust_local(version, constraint, prefix)                       
 358 │ 358 │         if not prefix:                                                                              
 359 │ 359 │             result = (version == constraint)                                                        
 360 │ 360 │         else:                                                                                       
 361 │ 361 │             result = _match_prefix(version, constraint)                                             
 362 │ 362 │         return result                                                                               
 363 │ 363 │                                                                                                     
 364 │ 364 │     def _match_arbitrary(self, version, constraint, prefix):                                        
 365 │ 365 │         return str(version) == str(constraint)                                                      
 366 │ 366 │                                                                                                     
 367 │ 367 │     def _match_ne(self, version, constraint, prefix):                                               
 368 │ 368 │         version, constraint = self._adjust_local(version, constraint, prefix)                       
 369 │ 369 │         if not prefix:                                                                              
 370 │ 370 │             result = (version != constraint)                                                        
 371 │ 371 │         else:                                                                                       
 372 │ 372 │             result = not _match_prefix(version, constraint)                                         
 373 │ 373 │         return result                                                                               
 374 │ 374 │                                                                                                     
 375 │ 375 │     def _match_compatible(self, version, constraint, prefix):                                       
 376 │ 376 │         version, constraint = self._adjust_local(version, constraint, prefix)                       
 377 │ 377 │         if version == constraint:                                                                   
 378 │ 378 │             return True                                                                             
 379 │ 379 │         if version < constraint:                                                                    
 380 │ 380 │             return False                                                                            
 381 │ 381 │ #        if not prefix:                                                                             
 382 │ 382 │ #            return True                                                                            
 383 │ 383 │         release_clause = constraint._release_clause                                                 
 384 │ 384 │         if len(release_clause) > 1:                                                                 
 385 │ 385 │             release_clause = release_clause[:-1]                                                    
 386 │ 386 │         pfx = '.'.join([str(i) for i in release_clause])                                            
 387 │ 387 │         return _match_prefix(version, pfx)                                                          
 388 │ 388 │                                                                                                     
 389 │ 389 │                                                                                                     
 390 │ 390 │ _REPLACEMENTS = (                                                                                   
 391 │ 391 │     (re.compile('[.+-]$'), ''),                     # remove trailing puncts                        
 392 │ 392 │     (re.compile(r'^[.](\d)'), r'0.\1'),             # .N -> 0.N at start                            
 393 │ 393 │     (re.compile('^[.-]'), ''),                      # remove leading puncts                         
 394 │ 394 │     (re.compile(r'^\((.*)\)$'), r'\1'),             # remove parentheses                            
 395 │ 395 │     (re.compile(r'^v(ersion)?\s*(\d+)'), r'\2'),    # remove leading v(ersion)                      
 396 │ 396 │     (re.compile(r'^r(ev)?\s*(\d+)'), r'\2'),        # remove leading v(ersion)                      
 397 │ 397 │     (re.compile('[.]{2,}'), '.'),                   # multiple runs of '.'                          
 398 │ 398 │     (re.compile(r'(alfa|apha)'), 'alpha'),      # misspelt alpha                                
 399 │ 399 │     (re.compile(r'(pre-alpha|prealpha)'),                                                       
 400 │ 400 │         'pre.alpha'),                               # standardise                                   
 401 │ 401 │     (re.compile(r'\(beta\)$'), 'beta'),             # remove parentheses                            
 402 │ 402 │ )                                                                                                   
 403 │ 403 │                                                                                                     
 404 │ 404 │ _SUFFIX_REPLACEMENTS = (                                                                            
 405 │ 405 │     (re.compile('^[:~._+-]+'), ''),                   # remove leading puncts                       
 406 │ 406 │     (re.compile('[,*")([\]]'), ''),                  # remove unwanted chars                       
 407 │ 407 │     (re.compile('[~:+_ -]'), '.'),                    # replace illegal chars                       
 408 │ 408 │     (re.compile('[.]{2,}'), '.'),                   # multiple runs of '.'                          
 409 │ 409 │     (re.compile(r'\.$'), ''),                       # trailing '.'                                  
 410 │ 410 │ )                                                                                                   
 411 │ 411 │                                                                                                     
 412 │ 412 │ _NUMERIC_PREFIX = re.compile(r'(\d+(\.\d+)*)')                                                      
 413 │ 413 │                                                                                                     
 414 │ 414 │                                                                                                     
 415 │ 415 │ def _suggest_semantic_version(s):                                                                   
 416 │ 416 │     """                                                                                             
 417 │ 417 │     Try to suggest a semantic form for a version for which                                          
 418 │ 418 │     _suggest_normalized_version couldn't come up with anything.                                     
 419 │ 419 │     """                                                                                             
 420 │ 420 │     result = s.strip().lower()                                                                      
 421 │ 421 │     for pat, repl in _REPLACEMENTS:                                                                 
 422 │ 422 │         result = pat.sub(repl, result)                                                              
 423 │ 423 │     if not result:                                                                                  
 424 │ 424 │         result = '0.0.0'                                                                            
 425 │ 425 │                                                                                                     
 426 │ 426 │     # Now look for numeric prefix, and separate it out from                                         
 427 │ 427 │     # the rest.                                                                                     
 428 │ 428 │     # import pdb; pdb.set_trace()                                                                   
 429 │ 429 │     m = _NUMERIC_PREFIX.match(result)                                                               
 430 │ 430 │     if not m:                                                                                       
 431 │ 431 │         prefix = '0.0.0'                                                                            
 432 │ 432 │         suffix = result                                                                             
 433 │ 433 │     else:                                                                                           
 434 │ 434 │         prefix = m.groups()[0].split('.')                                                           
 435 │ 435 │         prefix = [int(i) for i in prefix]                                                           
 436 │ 436 │         while len(prefix) < 3:                                                                      
 437 │ 437 │             prefix.append(0)                                                                        
 438 │ 438 │         if len(prefix) == 3:                                                                        
 439 │ 439 │             suffix = result[m.end():]                                                               
 440 │ 440 │         else:                                                                                       
 441 │ 441 │             suffix = '.'.join([str(i) for i in prefix[3:]]) + result[m.end():]                      
 442 │ 442 │             prefix = prefix[:3]                                                                     
 443 │ 443 │         prefix = '.'.join([str(i) for i in prefix])                                                 
 444 │ 444 │         suffix = suffix.strip()                                                                     
 445 │ 445 │     if suffix:                                                                                      
 446 │ 446 │         # import pdb; pdb.set_trace()                                                               
 447 │ 447 │         # massage the suffix.                                                                       
 448 │ 448 │         for pat, repl in _SUFFIX_REPLACEMENTS:                                                      
 449 │ 449 │             suffix = pat.sub(repl, suffix)                                                          
 450 │ 450 │                                                                                                     
 451 │ 451 │     if not suffix:                                                                                  
 452 │ 452 │         result = prefix                                                                             
 453 │ 453 │     else:                                                                                           
 454 │ 454 │         sep = '-' if 'dev' in suffix else '+'                                                       
 455 │ 455 │         result = prefix + sep + suffix                                                              
 456 │ 456 │     if not is_semver(result):                                                                       
 457 │ 457 │         result = None                                                                               
 458 │ 458 │     return result                                                                                   
 459 │ 459 │                                                                                                     
 460 │ 460 │                                                                                                     
 461 │ 461 │ def _suggest_normalized_version(s):                                                                 
 462 │ 462 │     """Suggest a normalized version close to the given version string.                              
 463 │ 463 │                                                                                                     
 464 │ 464 │     If you have a version string that isn't rational (i.e. NormalizedVersion                        
 465 │ 465 │     doesn't like it) then you might be able to get an equivalent (or close)                         
 466 │ 466 │     rational version from this function.                                                            
 467 │ 467 │                                                                                                     
 468 │ 468 │     This does a number of simple normalizations to the given string, based                          
 469 │ 469 │     on observation of versions currently in use on PyPI. Given a dump of                            
 470 │ 470 │     those version during PyCon 2009, 4287 of them:                                                  
 471 │ 471 │     - 2312 (53.93%) match NormalizedVersion without change                                          
 472 │ 472 │       with the automatic suggestion                                                                 
 473 │ 473 │     - 3474 (81.04%) match when using this suggestion method                                         
 474 │ 474 │                                                                                                     
 475 │ 475 │     @param s {str} An irrational version string.                                                    
 476 │ 476 │     @returns A rational version string, or None, if couldn't determine one.                         
 477 │ 477 │     """                                                                                             
 478 │ 478 │     try:                                                                                            
 479 │ 479 │         _normalized_key(s)                                                                          
 480 │ 480 │         return s   # already rational                                                               
 481 │ 481 │     except UnsupportedVersionError:                                                                 
 482 │ 482 │         pass                                                                                        
 483 │ 483 │                                                                                                     
 484 │ 484 │     rs = s.lower()                                                                                  
 485 │ 485 │                                                                                                     
 486 │ 486 │     # part of this could use maketrans                                                              
 487 │ 487 │     for orig, repl in (('-alpha', 'a'), ('-beta', 'b'), ('alpha', 'a'),                             
 488 │ 488 │                        ('beta', 'b'), ('rc', 'c'), ('-final', ''),                                  
 489 │ 489 │                        ('-pre', 'c'),                                                               
 490 │ 490 │                        ('-release', ''), ('.release', ''), ('-stable', ''),                         
 491 │ 491 │                        ('+', '.'), ('_', '.'), (' ', ''), ('.final', ''),                           
 492 │ 492 │                        ('final', '')):                                                              
 493 │ 493 │         rs = rs.replace(orig, repl)                                                                 
 494 │ 494 │                                                                                                     
 495 │ 495 │     # if something ends with dev or pre, we add a 0                                                 
 496 │ 496 │     rs = re.sub(r"pre$", r"pre0", rs)                                                               
 497 │ 497 │     rs = re.sub(r"dev$", r"dev0", rs)                                                               
 498 │ 498 │                                                                                                     
 499 │ 499 │     # if we have something like "b-2" or "a.2" at the end of the                                    
 500 │ 500 │     # version, that is probably beta, alpha, etc                                                    
 501 │ 501 │     # let's remove the dash or dot                                                                  
 502 │ 502 │     rs = re.sub(r"([abc]|rc)[\-\.](\d+)$", r"\1\2", rs)                                             
 503 │ 503 │                                                                                                     
 504 │ 504 │     # 1.0-dev-r371 -> 1.0.dev371                                                                    
 505 │ 505 │     # 0.1-dev-r79 -> 0.1.dev79                                                                      
 506 │ 506 │     rs = re.sub(r"[\-\.](dev)[\-\.]?r?(\d+)$", r".\1\2", rs)                                        
 507 │ 507 │                                                                                                     
 508 │ 508 │     # Clean: 2.0.a.3, 2.0.b1, 0.9.0~c1                                                              
 509 │ 509 │     rs = re.sub(r"[.~]?([abc])\.?", r"\1", rs)                                                      
 510 │ 510 │                                                                                                     
 511 │ 511 │     # Clean: v0.3, v1.0                                                                             
 512 │ 512 │     if rs.startswith('v'):                                                                          
 513 │ 513 │         rs = rs[1:]                                                                                 
 514 │ 514 │                                                                                                     
 515 │ 515 │     # Clean leading '0's on numbers.                                                                
 516 │ 516 │     # TODO: unintended side-effect on, e.g., "2003.05.09"                                           
 517 │ 517 │     # PyPI stats: 77 (~2%) better                                                                   
 518 │ 518 │     rs = re.sub(r"0+(\d+)(?!\d)", r"\1", rs)                                                      
 519 │ 519 │                                                                                                     
 520 │ 520 │     # Clean a/b/c with no version. E.g. "1.0a" -> "1.0a0". Setuptools infers                        
 521 │ 521 │     # zero.                                                                                         
 522 │ 522 │     # PyPI stats: 245 (7.56%) better                                                                
 523 │ 523 │     rs = re.sub(r"(\d+[abc])$", r"\g<1>0", rs)                                                      
 524 │ 524 │                                                                                                     
 525 │ 525 │     # the 'dev-rNNN' tag is a dev tag                                                               
 526 │ 526 │     rs = re.sub(r"\.?(dev-r|dev\.r)\.?(\d+)$", r".dev\2", rs)                                       
 527 │ 527 │                                                                                                     
 528 │ 528 │     # clean the - when used as a pre delimiter                                                      
 529 │ 529 │     rs = re.sub(r"-(a|b|c)(\d+)$", r"\1\2", rs)                                                     
 530 │ 530 │                                                                                                     
 531 │ 531 │     # a terminal "dev" or "devel" can be changed into ".dev0"                                       
 532 │ 532 │     rs = re.sub(r"[\.\-](dev|devel)$", r".dev0", rs)                                                
 533 │ 533 │                                                                                                     
 534 │ 534 │     # a terminal "dev" can be changed into ".dev0"                                                  
 535 │ 535 │     rs = re.sub(r"(?![\.\-])dev$", r".dev0", rs)                                                    
 536 │ 536 │                                                                                                     
 537 │ 537 │     # a terminal "final" or "stable" can be removed                                                 
 538 │ 538 │     rs = re.sub(r"(final|stable)$", "", rs)                                                         
 539 │ 539 │                                                                                                     
 540 │ 540 │     # The 'r' and the '-' tags are post release tags                                                
 541 │ 541 │     #   0.4a1.r10       ->  0.4a1.post10                                                            
 542 │ 542 │     #   0.9.33-17222    ->  0.9.33.post17222                                                        
 543 │ 543 │     #   0.9.33-r17222   ->  0.9.33.post17222                                                        
 544 │ 544 │     rs = re.sub(r"\.?(r|-|-r)\.?(\d+)$", r".post\2", rs)                                            
 545 │ 545 │                                                                                                     
 546 │ 546 │     # Clean 'r' instead of 'dev' usage:                                                             
 547 │ 547 │     #   0.9.33+r17222   ->  0.9.33.dev17222                                                         
 548 │ 548 │     #   1.0dev123       ->  1.0.dev123                                                              
 549 │ 549 │     #   1.0.git123      ->  1.0.dev123                                                              
 550 │ 550 │     #   1.0.bzr123      ->  1.0.dev123                                                              
 551 │ 551 │     #   0.1a0dev.123    ->  0.1a0.dev123                                                            
 552 │ 552 │     # PyPI stats:  ~150 (~4%) better                                                                
 553 │ 553 │     rs = re.sub(r"\.?(dev|git|bzr)\.?(\d+)$", r".dev\2", rs)                                        
 554 │ 554 │                                                                                                     
 555 │ 555 │     # Clean '.pre' (normalized from '-pre' above) instead of 'c' usage:                             
 556 │ 556 │     #   0.2.pre1        ->  0.2c1                                                                   
 557 │ 557 │     #   0.2-c1         ->  0.2c1                                                                    
 558 │ 558 │     #   1.0preview123   ->  1.0c123                                                                 
 559 │ 559 │     # PyPI stats: ~21 (0.62%) better                                                                
 560 │ 560 │     rs = re.sub(r"\.?(pre|preview|-c)(\d+)$", r"c\g<2>", rs)                                        
 561 │ 561 │                                                                                                     
 562 │ 562 │     # Tcl/Tk uses "px" for their post release markers                                               
 563 │ 563 │     rs = re.sub(r"p(\d+)$", r".post\1", rs)                                                         
 564 │ 564 │                                                                                                     
 565 │ 565 │     try:                                                                                            
 566 │ 566 │         _normalized_key(rs)                                                                         
 567 │ 567 │     except UnsupportedVersionError:                                                                 
 568 │ 568 │         rs = None                                                                                   
 569 │ 569 │     return rs                                                                                       
 570 │ 570 │                                                                                                     
 571 │ 571 │ #                                                                                                   
 572 │ 572 │ #   Legacy version processing (distribute-compatible)                                               
 573 │ 573 │ #                                                                                                   
 574 │ 574 │                                                                                                     
 575 │ 575 │                                                                                                     
 576 │ 576 │ _VERSION_PART = re.compile(r'([a-z]+|\d+|[\.-])', re.I)                                             
 577 │ 577 │ _VERSION_REPLACE = {                                                                                
 578 │ 578 │     'pre': 'c',                                                                                     
 579 │ 579 │     'preview': 'c',                                                                                 
 580 │ 580 │     '-': 'final-',                                                                                  
 581 │ 581 │     'rc': 'c',                                                                                      
 582 │ 582 │     'dev': '@',                                                                                     
 583 │ 583 │     '': None,                                                                                       
 584 │ 584 │     '.': None,                                                                                      
 585 │ 585 │ }                                                                                                   
 586 │ 586 │                                                                                                     
 587 │ 587 │                                                                                                     
 588 │ 588 │ def _legacy_key(s):                                                                                 
 589 │ 589 │     def get_parts(s):                                                                               
 590 │ 590 │         result = []                                                                                 
 591 │ 591 │         for p in _VERSION_PART.split(s.lower()):                                                    
 592 │ 592 │             p = _VERSION_REPLACE.get(p, p)                                                          
 593 │ 593 │             if p:                                                                                   
 594 │ 594 │                 if '0' <= p[:1] <= '9':                                                             
 595 │ 595 │                     p = p.zfill(8)                                                                  
 596 │ 596 │                 else:                                                                               
 597 │ 597 │                     p = '*' + p                                                                     
 598 │ 598 │                 result.append(p)                                                                    
 599 │ 599 │         result.append('*final')                                                                     
 600 │ 600 │         return result                                                                               
 601 │ 601 │                                                                                                     
 602 │ 602 │     result = []                                                                                     
 603 │ 603 │     for p in get_parts(s):                                                                          
 604 │ 604 │         if p.startswith('*'):                                                                       
 605 │ 605 │             if p < '*final':                                                                        
 606 │ 606 │                 while result and result[-1] == '*final-':                                           
 607 │ 607 │                     result.pop()                                                                    
 608 │ 608 │             while result and result[-1] == '00000000':                                              
 609 │ 609 │                 result.pop()                                                                        
 610 │ 610 │         result.append(p)                                                                            
 611 │ 611 │     return tuple(result)                                                                            
 612 │ 612 │                                                                                                     
 613 │ 613 │                                                                                                     
 614 │ 614 │ class LegacyVersion(Version):                                                                       
 615 │ 615 │     def parse(self, s):                                                                             
 616 │ 616 │         return _legacy_key(s)                                                                       
 617 │ 617 │                                                                                                     
 618 │ 618 │     @property                                                                                       
 619 │ 619 │     def is_prerelease(self):                                                                        
 620 │ 620 │         result = False                                                                              
 621 │ 621 │         for x in self._parts:                                                                       
 622 │ 622 │             if (isinstance(x, string_types) and x.startswith('*') and x < '*final'):                
 623 │ 623 │                 result = True                                                                       
 624 │ 624 │                 break                                                                               
 625 │ 625 │         return result                                                                               
 626 │ 626 │                                                                                                     
 627 │ 627 │                                                                                                     
 628 │ 628 │ class LegacyMatcher(Matcher):                                                                       
 629 │ 629 │     version_class = LegacyVersion                                                                   
 630 │ 630 │                                                                                                     
 631 │ 631 │     _operators = dict(Matcher._operators)                                                           
 632 │ 632 │     _operators['~='] = '_match_compatible'                                                          
 633 │ 633 │                                                                                                     
 634 │ 634 │     numeric_re = re.compile(r'^(\d+(\.\d+)*)')                                                      
 635 │ 635 │                                                                                                     
 636 │ 636 │     def _match_compatible(self, version, constraint, prefix):                                       
 637 │ 637 │         if version < constraint:                                                                    
 638 │ 638 │             return False                                                                            
 639 │ 639 │         m = self.numeric_re.match(str(constraint))                                                  
 640 │ 640 │         if not m:                                                                                   
 641 │ 641 │             logger.warning('Cannot compute compatible match for version %s '                        
 642 │ 642 │                            ' and constraint %s', version, constraint)                               
 643 │ 643 │             return True                                                                             
 644 │ 644 │         s = m.groups()[0]                                                                           
 645 │ 645 │         if '.' in s:                                                                                
 646 │ 646 │             s = s.rsplit('.', 1)[0]                                                                 
 647 │ 647 │         return _match_prefix(version, s)                                                            
 648 │ 648 │                                                                                                     
 649 │ 649 │ #                                                                                                   
 650 │ 650 │ #   Semantic versioning                                                                             
 651 │ 651 │ #                                                                                                   
 652 │ 652 │                                                                                                     
 653 │ 653 │                                                                                                     
 654 │ 654 │ _SEMVER_RE = re.compile(r'^(\d+)\.(\d+)\.(\d+)'                                                     
 655 │ 655 │                         r'(-[a-z0-9]+(\.[a-z0-9-]+)*)?'                                             
 656 │ 656 │                         r'(\+[a-z0-9]+(\.[a-z0-9-]+)*)?$', re.I)                                    
 657 │ 657 │                                                                                                     
 658 │ 658 │                                                                                                     
 659 │ 659 │ def is_semver(s):                                                                                   
 660 │ 660 │     return _SEMVER_RE.match(s)                                                                      
 661 │ 661 │                                                                                                     
 662 │ 662 │                                                                                                     
 663 │ 663 │ def _semantic_key(s):                                                                               
 664 │ 664 │     def make_tuple(s, absent):                                                                      
