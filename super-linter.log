 363 │ 363 │     def _glob_to_re(self, pattern):                                                    
 364 │ 364 │         """Translate a shell-like glob pattern to a regular expression.                
 365 │ 365 │                                                                                        
 366 │ 366 │         Return a string containing the regex.  Differs from                            
 367 │ 367 │         'fnmatch.translate()' in that '*' does not match "special characters"          
 368 │ 368 │         (which are platform-specific).                                                 
 369 │ 369 │         """                                                                            
 370 │ 370 │         pattern_re = fnmatch.translate(pattern)                                        
 371 │ 371 │                                                                                        
 372 │ 372 │         # '?' and '*' in the glob pattern become '.' and '.*' in the RE, which         
 373 │ 373 │         # IMHO is wrong -- '?' and '*' aren't supposed to match slash in Unix,         
 374 │ 374 │         # and by extension they shouldn't match such "special characters" under        
 375 │ 375 │         # any OS.  So change all non-escaped dots in the RE to match any               
 376 │ 376 │         # character except the special characters (currently: just os.sep).            
 377 │ 377 │         sep = os.sep                                                                   
 378 │ 378 │         if os.sep == '\':                                                             
 379 │ 379 │             # we're using a regex to manipulate a regex, so we need                    
 380 │ 380 │             # to escape the backslash twice                                            
 381 │ 381 │             sep = r'\\'                                                              
 382 │ 382 │         escaped = r'\1[^%s]' % sep                                                     
 383 │ 383 │         pattern_re = re.sub(r'((?<!\)(\\)*)\.', escaped, pattern_re)                
