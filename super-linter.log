 110 │ 110 │     def _pattern_permute(                                                               
 111 │ 111 │         self, basic_pattern: str, options: str, basic_result: int                       
 112 │ 112 │     ) -> list[tuple[str, int]]:                                                         
 113 │ 113 │         """pattern_permute takes a basic pattern and its result and clones              
 114 │ 114 │         the pattern according to the modifications described in the $options            
 115 │ 115 │         parameter. It returns a list of all cloned patterns."""                         
 116 │ 116 │         patterns = [(basic_pattern, basic_result)]                                      
 117 │ 117 │                                                                                         
 118 │ 118 │         # rotations                                                                     
 119 │ 119 │         if "4" in options:                                                              
 120 │ 120 │             res = patterns[-1][1]                                                       
