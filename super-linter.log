 355 │ 355 │ def _mac_arch(arch: str, is_32bit: bool = _32_BIT_INTERPRETER) -> str:                     
 356 │ 356 │     if not is_32bit:                                                                       
 357 │ 357 │         return arch                                                                        
 358 │ 358 │                                                                                            
 359 │ 359 │     if arch.startswith("ppc"):                                                             
 360 │ 360 │         return "ppc"                                                                       
 361 │ 361 │                                                                                            
 362 │ 362 │     return "i386"                                                                          
 363 │ 363 │                                                                                            
 364 │ 364 │                                                                                            
 365 │ 365 │ def _mac_binary_formats(version: AppleVersion, cpu_arch: str) -> list[str]:                
 366 │ 366 │     formats = [cpu_arch]                                                                   
 367 │ 367 │     if cpu_arch == "x86_64":                                                               
 368 │ 368 │         if version < (10, 4):                                                              
 369 │ 369 │             return []                                                                      
 370 │ 370 │         formats.extend(["intel", "fat64", "fat32"])                                        
 371 │ 371 │                                                                                            
 372 │ 372 │     elif cpu_arch == "i386":                                                               
 373 │ 373 │         if version < (10, 4):                                                              
 374 │ 374 │             return []                                                                      
 375 │ 375 │         formats.extend(["intel", "fat32", "fat"])                                          
 376 │ 376 │                                                                                            
 377 │ 377 │     elif cpu_arch == "ppc64":                                                              
 378 │ 378 │         # TODO: Need to care about 32-bit PPC for ppc64 through 10.2?                      
 379 │ 379 │         if version > (10, 5) or version < (10, 4):                                         
 380 │ 380 │             return []                                                                      
 381 │ 381 │         formats.append("fat64")                                                            
 382 │ 382 │                                                                                            
 383 │ 383 │     elif cpu_arch == "ppc":                                                                
 384 │ 384 │         if version > (10, 6):                                                              
 385 │ 385 │             return []                                                                      
 386 │ 386 │         formats.extend(["fat32", "fat"])                                                   
 387 │ 387 │                                                                                            
 388 │ 388 │     if cpu_arch in {"arm64", "x86_64"}:                                                    
 389 │ 389 │         formats.append("universal2")                                                       
 390 │ 390 │                                                                                            
 391 │ 391 │     if cpu_arch in {"x86_64", "i386", "ppc64", "ppc", "intel"}:                            
 392 │ 392 │         formats.append("universal")                                                        
 393 │ 393 │                                                                                            
 394 │ 394 │     return formats                                                                         
 395 │ 395 │                                                                                            
