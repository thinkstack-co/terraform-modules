 141 │ 141 │ def _parse_jp2_header(                                                                   
 142 │ 142 │     fp: IO[bytes],                                                                       
 143 │ 143 │ ) -> tuple[                                                                              
 144 │ 144 │     tuple[int, int],                                                                     
 145 │ 145 │     str,                                                                                 
 146 │ 146 │     str | None,                                                                          
 147 │ 147 │     tuple[float, float] | None,                                                          
