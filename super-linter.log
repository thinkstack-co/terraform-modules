 60 │ 60 │             coding_state = self.coding_sm.next_state(c)                
 61 │ 61 │             if coding_state == MachineState.ERROR:                     
 62 │ 62 │                 self._state = ProbingState.NOT_ME                      
 63 │ 63 │                 break                                                  
 64 │ 64 │             if coding_state == MachineState.ITS_ME:                    
 65 │ 65 │                 self._state = ProbingState.FOUND_IT                    
 66 │ 66 │                 break                                                  
 67 │ 67 │             if coding_state == MachineState.START:                     
 68 │ 68 │                 if self.coding_sm.get_current_charlen() >= 2:          
 69 │ 69 │                     self._num_mb_chars += 1                            
 70 │ 70 │                                                                        
 71 │ 71 │         if self.state == ProbingState.DETECTING:                       
 72 │ 72 │             if self.get_confidence() > self.SHORTCUT_THRESHOLD:        
 73 │ 73 │                 self._state = ProbingState.FOUND_IT                    
 74 │ 74 │                                                                        
 75 │ 75 │         return self.state                                              
