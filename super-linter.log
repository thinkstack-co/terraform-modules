 184 │ 184 │ def cpython_tags(                                                                          
 185 │ 185 │     python_version: PythonVersion | None = None,                                           
 186 │ 186 │     abis: Iterable[str] | None = None,                                                     
 187 │ 187 │     platforms: Iterable[str] | None = None,                                                
 188 │ 188 │     *,                                                                                     
 189 │ 189 │     warn: bool = False,                                                                    
 190 │ 190 │ ) -> Iterator[Tag]:                                                                        
 191 │ 191 │     """                                                                                    
 192 │ 192 │     Yields the tags for a CPython interpreter.                                             
 193 │ 193 │                                                                                            
 194 │ 194 │     The tags consist of:                                                                   
 195 │ 195 │     - cp<python_version>-<abi>-<platform>                                                  
 196 │ 196 │     - cp<python_version>-abi3-<platform>                                                   
 197 │ 197 │     - cp<python_version>-none-<platform>                                                   
 198 │ 198 │     - cp<less than python_version>-abi3-<platform>  # Older Python versions down to 3.2.   
 199 │ 199 │                                                                                            
 200 │ 200 │     If python_version only specifies a major version then user-provided ABIs and           
 201 │ 201 │     the 'none' ABItag will be used.                                                        
 202 │ 202 │                                                                                            
 203 │ 203 │     If 'abi3' or 'none' are specified in 'abis' then they will be yielded at               
 204 │ 204 │     their normal position and not at the beginning.                                        
 205 │ 205 │     """                                                                                    
 206 │ 206 │     if not python_version:                                                                 
 207 │ 207 │         python_version = sys.version_info[:2]                                              
 208 │ 208 │                                                                                            
 209 │ 209 │     interpreter = f"cp{_version_nodot(python_version[:2])}"                                
 210 │ 210 │                                                                                            
 211 │ 211 │     if abis is None:                                                                       
 212 │ 212 │         if len(python_version) > 1:                                                        
 213 │ 213 │             abis = _cpython_abis(python_version, warn)                                     
 214 │ 214 │         else:                                                                              
 215 │ 215 │             abis = []                                                                      
 216 │ 216 │     abis = list(abis)                                                                      
 217 │ 217 │     # 'abi3' and 'none' are explicitly handled later.                                      
 218 │ 218 │     for explicit_abi in ("abi3", "none"):                                                  
 219 │ 219 │         try:                                                                               
 220 │ 220 │             abis.remove(explicit_abi)                                                      
 221 │ 221 │         except ValueError:                                                                 
 222 │ 222 │             pass                                                                           
 223 │ 223 │                                                                                            
 224 │ 224 │     platforms = list(platforms or platform_tags())                                         
 225 │ 225 │     for abi in abis:                                                                       
 226 │ 226 │         for platform_ in platforms:                                                        
 227 │ 227 │             yield Tag(interpreter, abi, platform_)                                         
 228 │ 228 │                                                                                            
 229 │ 229 │     threading = _is_threaded_cpython(abis)                                                 
 230 │ 230 │     use_abi3 = _abi3_applies(python_version, threading)                                    
 231 │ 231 │     if use_abi3:                                                                           
 232 │ 232 │         yield from (Tag(interpreter, "abi3", platform_) for platform_ in platforms)        
 233 │ 233 │     yield from (Tag(interpreter, "none", platform_) for platform_ in platforms)            
 234 │ 234 │                                                                                            
 235 │ 235 │     if use_abi3:                                                                           
 236 │ 236 │         for minor_version in range(python_version[1] - 1, 1, -1):                          
 237 │ 237 │             for platform_ in platforms:                                                    
 238 │ 238 │                 version = _version_nodot((python_version[0], minor_version))               
 239 │ 239 │                 interpreter = f"cp{version}"                                               
 240 │ 240 │                 yield Tag(interpreter, "abi3", platform_)                                  
