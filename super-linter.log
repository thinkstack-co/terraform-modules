 243 │ 243 │ def _generic_abi() -> list[str]:                                                           
 244 │ 244 │     """                                                                                    
 245 │ 245 │     Return the ABI tag based on EXT_SUFFIX.                                                
 246 │ 246 │     """                                                                                    
 247 │ 247 │     # The following are examples of `EXT_SUFFIX`.                                          
 248 │ 248 │     # We want to keep the parts which are related to the ABI and remove the                
 249 │ 249 │     # parts which are related to the platform:                                             
 250 │ 250 │     # - linux:   '.cpython-310-x86_64-linux-gnu.so' => cp310                               
 251 │ 251 │     # - mac:     '.cpython-310-darwin.so'           => cp310                               
 252 │ 252 │     # - win:     '.cp310-win_amd64.pyd'             => cp310                               
 253 │ 253 │     # - win:     '.pyd'                             => cp37 (uses _cpython_abis())         
 254 │ 254 │     # - pypy:    '.pypy38-pp73-x86_64-linux-gnu.so' => pypy38_pp73                         
 255 │ 255 │     # - graalpy: '.graalpy-38-native-x86_64-darwin.dylib'                                  
 256 │ 256 │     #                                               => graalpy_38_native                   
 257 │ 257 │                                                                                            
 258 │ 258 │     ext_suffix = _get_config_var("EXT_SUFFIX", warn=True)                                  
 259 │ 259 │     if not isinstance(ext_suffix, str) or ext_suffix[0] != ".":                            
 260 │ 260 │         raise SystemError("invalid sysconfig.get_config_var('EXT_SUFFIX')")                
 261 │ 261 │     parts = ext_suffix.split(".")                                                          
 262 │ 262 │     if len(parts) < 3:                                                                     
 263 │ 263 │         # CPython3.7 and earlier uses ".pyd" on Windows.                                   
 264 │ 264 │         return _cpython_abis(sys.version_info[:2])                                         
 265 │ 265 │     soabi = parts[1]                                                                       
 266 │ 266 │     if soabi.startswith("cpython"):                                                        
 267 │ 267 │         # non-windows                                                                      
 268 │ 268 │         abi = "cp" + soabi.split("-")[1]                                                   
 269 │ 269 │     elif soabi.startswith("cp"):                                                           
 270 │ 270 │         # windows                                                                          
 271 │ 271 │         abi = soabi.split("-")[0]                                                          
 272 │ 272 │     elif soabi.startswith("pypy"):                                                         
 273 │ 273 │         abi = "-".join(soabi.split("-")[:2])                                               
 274 │ 274 │     elif soabi.startswith("graalpy"):                                                      
 275 │ 275 │         abi = "-".join(soabi.split("-")[:3])                                               
 276 │ 276 │     elif soabi:                                                                            
 277 │ 277 │         # pyston, ironpython, others?                                                      
 278 │ 278 │         abi = soabi                                                                        
 279 │ 279 │     else:                                                                                  
 280 │ 280 │         return []                                                                          
 281 │ 281 │     return [_normalize_string(abi)]                                                        
 282 │ 282 │                                                                                            
 283 │ 283 │                                                                                            
 284 │ 284 │ def generic_tags(                                                                          
 285 │ 285 │     interpreter: str | None = None,                                                        
 286 │ 286 │     abis: Iterable[str] | None = None,                                                     
 287 │ 287 │     platforms: Iterable[str] | None = None,                                                
 288 │ 288 │     *,                                                                                     
 289 │ 289 │     warn: bool = False,                                                                    
 290 │ 290 │ ) -> Iterator[Tag]:                                                                        
 291 │ 291 │     """                                                                                    
 292 │ 292 │     Yields the tags for a generic interpreter.                                             
 293 │ 293 │                                                                                            
 294 │ 294 │     The tags consist of:                                                                   
 295 │ 295 │     - <interpreter>-<abi>-<platform>                                                       
 296 │ 296 │                                                                                            
 297 │ 297 │     The "none" ABI will be added if it was not explicitly provided.                        
 298 │ 298 │     """                                                                                    
 299 │ 299 │     if not interpreter:                                                                    
 300 │ 300 │         interp_name = interpreter_name()                                                   
 301 │ 301 │         interp_version = interpreter_version(warn=warn)                                    
 302 │ 302 │         interpreter = "".join([interp_name, interp_version])                               
 303 │ 303 │     if abis is None:                                                                       
 304 │ 304 │         abis = _generic_abi()                                                              
 305 │ 305 │     else:                                                                                  
 306 │ 306 │         abis = list(abis)                                                                  
 307 │ 307 │     platforms = list(platforms or platform_tags())                                         
 308 │ 308 │     if "none" not in abis:                                                                 
 309 │ 309 │         abis.append("none")                                                                
 310 │ 310 │     for abi in abis:                                                                       
 311 │ 311 │         for platform_ in platforms:                                                        
 312 │ 312 │             yield Tag(interpreter, abi, platform_)                                         
