 484 │ 470 │ def expand(                                                                             
 485 │ 471 │     image: Image.Image,                                                                 
 486 │ 472 │     border: int | tuple[int, ...] = 0,                                                  
 487 │ 473 │     fill: str | int | tuple[int, ...] = 0,                                              
 488 │ 474 │ ) -> Image.Image:                                                                       
 489 │ 475 │     """                                                                                 
 490 │ 476 │     Add border to the image                                                             
 491 │ 477 │                                                                                         
 492 │ 478 │     :param image: The image to expand.                                                  
 493 │ 479 │     :param border: Border width, in pixels.                                             
 494 │ 480 │     :param fill: Pixel fill value (a color value).  Default is 0 (black).               
 495 │ 481 │     :return: An image.                                                                  
 496 │ 482 │     """                                                                                 
 497 │ 483 │     left, top, right, bottom = _border(border)                                          
 498 │ 484 │     width = left + image.size[0] + right                                                
 499 │ 485 │     height = top + image.size[1] + bottom                                               
 500 │ 486 │     color = _color(fill, image.mode)                                                    
 501 │ 487 │     if image.palette:                                                                   
 502 │ 488 │         palette = ImagePalette.ImagePalette(palette=image.getpalette())                 
 503 │ 489 │         if isinstance(color, tuple) and (len(color) == 3 or len(color) == 4):           
 504 │ 490 │             color = palette.getcolor(color)                                             
 505 │ 491 │     else:                                                                               
 506 │ 492 │         palette = None                                                                  
 507 │ 493 │     out = Image.new(image.mode, (width, height), color)                                 
 508 │ 494 │     if palette:                                                                         
 509 │ 495 │         out.putpalette(palette.palette)                                                 
 510 │ 496 │     out.paste(image, (left, top))                                                       
 511 │ 497 │     return out                                                                          
