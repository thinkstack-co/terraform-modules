 160 │ 160 │                                                                                          
 161 │ 161 │ class Version(_BaseVersion):                                                             
 162 │ 162 │     """This class abstracts handling of a project's versions.                            
 163 │ 163 │                                                                                          
 164 │ 164 │     A :class:`Version` instance is comparison aware and can be compared and              
 165 │ 165 │     sorted using the standard Python interfaces.                                         
 166 │ 166 │                                                                                          
 167 │ 167 │     >>> v1 = Version("1.0a5")                                                            
 168 │ 168 │     >>> v2 = Version("1.0")                                                              
 169 │ 169 │     >>> v1                                                                               
 170 │ 170 │     <Version('1.0a5')>                                                                   
 171 │ 171 │     >>> v2                                                                               
 172 │ 172 │     <Version('1.0')>                                                                     
 173 │ 173 │     >>> v1 < v2                                                                          
 174 │ 174 │     True                                                                                 
 175 │ 175 │     >>> v1 == v2                                                                         
 176 │ 176 │     False                                                                                
 177 │ 177 │     >>> v1 > v2                                                                          
 178 │ 178 │     False                                                                                
 179 │ 179 │     >>> v1 >= v2                                                                         
 180 │ 180 │     False                                                                                
 181 │ 181 │     >>> v1 <= v2                                                                         
 182 │ 182 │     True                                                                                 
 183 │ 183 │     """                                                                                  
 184 │ 184 │                                                                                          
 185 │ 185 │     _regex = re.compile(r"^\s*" + VERSION_PATTERN + r"\s*$", re.VERBOSE | re.IGNORECASE) 
 186 │ 186 │     _key: CmpKey                                                                         
 187 │ 187 │                                                                                          
 188 │ 188 │     def __init__(self, version: str) -> None:                                            
 189 │ 189 │         """Initialize a Version object.                                                  
 190 │ 190 │                                                                                          
 191 │ 191 │         :param version:                                                                  
 192 │ 192 │             The string representation of a version which will be parsed and normalized   
 193 │ 193 │             before use.                                                                  
 194 │ 194 │         :raises InvalidVersion:                                                          
 195 │ 195 │             If the ``version`` does not conform to PEP 440 in any way then this          
 196 │ 196 │             exception will be raised.                                                    
 197 │ 197 │         """                                                                              
 198 │ 198 │                                                                                          
 199 │ 199 │         # Validate the version and parse it into pieces                                  
 200 │ 200 │         match = self._regex.search(version)                                              
 201 │ 201 │         if not match:                                                                    
 202 │ 202 │             raise InvalidVersion(f"Invalid version: {version!r}")                        
 203 │ 203 │                                                                                          
 204 │ 204 │         # Store the parsed out pieces of the version                                     
 205 │ 205 │         self._version = _Version(                                                        
 206 │ 206 │             epoch=int(match.group("epoch")) if match.group("epoch") else 0,              
 207 │ 207 │             release=tuple(int(i) for i in match.group("release").split(".")),            
 208 │ 208 │             pre=_parse_letter_version(match.group("pre_l"), match.group("pre_n")),       
 209 │ 209 │             post=_parse_letter_version(                                                  
 210 │ 210 │                 match.group("post_l"), match.group("post_n1") or match.group("post_n2")  
 211 │ 211 │             ),                                                                           
 212 │ 212 │             dev=_parse_letter_version(match.group("dev_l"), match.group("dev_n")),       
 213 │ 213 │             local=_parse_local_version(match.group("local")),                            
 214 │ 214 │         )                                                                                
 215 │ 215 │                                                                                          
 216 │ 216 │         # Generate a key which will be used for sorting                                  
 217 │ 217 │         self._key = _cmpkey(                                                             
 218 │ 218 │             self._version.epoch,                                                         
 219 │ 219 │             self._version.release,                                                       
 220 │ 220 │             self._version.pre,                                                           
 221 │ 221 │             self._version.post,                                                          
 222 │ 222 │             self._version.dev,                                                           
 223 │ 223 │             self._version.local,                                                         
 224 │ 224 │         )                                                                                
 225 │ 225 │                                                                                          
 226 │ 226 │     def __repr__(self) -> str:                                                           
 227 │ 227 │         """A representation of the Version that shows all internal state.                
 228 │ 228 │                                                                                          
 229 │ 229 │         >>> Version('1.0.0')                                                             
 230 │ 230 │         <Version('1.0.0')>                                                               
 231 │ 231 │         """                                                                              
 232 │ 232 │         return f"<Version('{self}')>"                                                    
 233 │ 233 │                                                                                          
 234 │ 234 │     def __str__(self) -> str:                                                            
 235 │ 235 │         """A string representation of the version that can be round-tripped.             
 236 │ 236 │                                                                                          
 237 │ 237 │         >>> str(Version("1.0a5"))                                                        
 238 │ 238 │         '1.0a5'                                                                          
 239 │ 239 │         """                                                                              
 240 │ 240 │         parts = []                                                                       
 241 │ 241 │                                                                                          
 242 │ 242 │         # Epoch                                                                          
 243 │ 243 │         if self.epoch != 0:                                                              
 244 │ 244 │             parts.append(f"{self.epoch}!")                                               
 245 │ 245 │                                                                                          
 246 │ 246 │         # Release segment                                                                
 247 │ 247 │         parts.append(".".join(str(x) for x in self.release))                             
 248 │ 248 │                                                                                          
 249 │ 249 │         # Pre-release                                                                    
 250 │ 250 │         if self.pre is not None:                                                         
 251 │ 251 │             parts.append("".join(str(x) for x in self.pre))                              
 252 │ 252 │                                                                                          
 253 │ 253 │         # Post-release                                                                   
 254 │ 254 │         if self.post is not None:                                                        
 255 │ 255 │             parts.append(f".post{self.post}")                                            
 256 │ 256 │                                                                                          
 257 │ 257 │         # Development release                                                            
 258 │ 258 │         if self.dev is not None:                                                         
 259 │ 259 │             parts.append(f".dev{self.dev}")                                              
 260 │ 260 │                                                                                          
 261 │ 261 │         # Local version segment                                                          
 262 │ 262 │         if self.local is not None:                                                       
 263 │ 263 │             parts.append(f"+{self.local}")                                               
 264 │ 264 │                                                                                          
 265 │ 265 │         return "".join(parts)                                                            
 266 │ 266 │                                                                                          
 267 │ 267 │     @property                                                                            
 268 │ 268 │     def epoch(self) -> int:                                                              
 269 │ 269 │         """The epoch of the version.                                                     
 270 │ 270 │                                                                                          
 271 │ 271 │         >>> Version("2.0.0").epoch                                                       
 272 │ 272 │         0                                                                                
 273 │ 273 │         >>> Version("1!2.0.0").epoch                                                     
 274 │ 274 │         1                                                                                
 275 │ 275 │         """                                                                              
 276 │ 276 │         return self._version.epoch                                                       
 277 │ 277 │                                                                                          
 278 │ 278 │     @property                                                                            
 279 │ 279 │     def release(self) -> tuple[int, ...]:                                                
 280 │ 280 │         """The components of the "release" segment of the version.                       
 281 │ 281 │                                                                                          
 282 │ 282 │         >>> Version("1.2.3").release                                                     
 283 │ 283 │         (1, 2, 3)                                                                        
 284 │ 284 │         >>> Version("2.0.0").release                                                     
 285 │ 285 │         (2, 0, 0)                                                                        
 286 │ 286 │         >>> Version("1!2.0.0.post0").release                                             
 287 │ 287 │         (2, 0, 0)                                                                        
 288 │ 288 │                                                                                          
 289 │ 289 │         Includes trailing zeroes but not the epoch or any pre-release / development /    
 290 │ 290 │         post-release suffixes.                                                           
 291 │ 291 │         """                                                                              
 292 │ 292 │         return self._version.release                                                     
 293 │ 293 │                                                                                          
 294 │ 294 │     @property                                                                            
 295 │ 295 │     def pre(self) -> tuple[str, int] | None:                                             
 296 │ 296 │         """The pre-release segment of the version.                                       
 297 │ 297 │                                                                                          
 298 │ 298 │         >>> print(Version("1.2.3").pre)                                                  
 299 │ 299 │         None                                                                             
 300 │ 300 │         >>> Version("1.2.3a1").pre                                                       
 301 │ 301 │         ('a', 1)                                                                         
 302 │ 302 │         >>> Version("1.2.3b1").pre                                                       
 303 │ 303 │         ('b', 1)                                                                         
 304 │ 304 │         >>> Version("1.2.3rc1").pre                                                      
 305 │ 305 │         ('rc', 1)                                                                        
 306 │ 306 │         """                                                                              
 307 │ 307 │         return self._version.pre                                                         
 308 │ 308 │                                                                                          
 309 │ 309 │     @property                                                                            
 310 │ 310 │     def post(self) -> int | None:                                                        
 311 │ 311 │         """The post-release number of the version.                                       
 312 │ 312 │                                                                                          
 313 │ 313 │         >>> print(Version("1.2.3").post)                                                 
 314 │ 314 │         None                                                                             
 315 │ 315 │         >>> Version("1.2.3.post1").post                                                  
 316 │ 316 │         1                                                                                
 317 │ 317 │         """                                                                              
 318 │ 318 │         return self._version.post[1] if self._version.post else None                     
 319 │ 319 │                                                                                          
 320 │ 320 │     @property                                                                            
 321 │ 321 │     def dev(self) -> int | None:                                                         
 322 │ 322 │         """The development number of the version.                                        
 323 │ 323 │                                                                                          
 324 │ 324 │         >>> print(Version("1.2.3").dev)                                                  
 325 │ 325 │         None                                                                             
 326 │ 326 │         >>> Version("1.2.3.dev1").dev                                                    
 327 │ 327 │         1                                                                                
 328 │ 328 │         """                                                                              
 329 │ 329 │         return self._version.dev[1] if self._version.dev else None                       
 330 │ 330 │                                                                                          
 331 │ 331 │     @property                                                                            
 332 │ 332 │     def local(self) -> str | None:                                                       
 333 │ 333 │         """The local version segment of the version.                                     
 334 │ 334 │                                                                                          
 335 │ 335 │         >>> print(Version("1.2.3").local)                                                
 336 │ 336 │         None                                                                             
 337 │ 337 │         >>> Version("1.2.3+abc").local                                                   
 338 │ 338 │         'abc'                                                                            
 339 │ 339 │         """                                                                              
 340 │ 340 │         if self._version.local:                                                          
 341 │ 341 │             return ".".join(str(x) for x in self._version.local)                         
 342 │ 342 │         else:                                                                            
 343 │ 343 │             return None                                                                  
 344 │ 344 │                                                                                          
 345 │ 345 │     @property                                                                            
 346 │ 346 │     def public(self) -> str:                                                             
 347 │ 347 │         """The public portion of the version.                                            
 348 │ 348 │                                                                                          
 349 │ 349 │         >>> Version("1.2.3").public                                                      
 350 │ 350 │         '1.2.3'                                                                          
 351 │ 351 │         >>> Version("1.2.3+abc").public                                                  
 352 │ 352 │         '1.2.3'                                                                          
 353 │ 353 │         >>> Version("1!1.2.3dev1+abc").public                                            
 354 │ 354 │         '1!1.2.3.dev1'                                                                   
 355 │ 355 │         """                                                                              
 356 │ 356 │         return str(self).split("+", 1)[0]                                                
 357 │ 357 │                                                                                          
 358 │ 358 │     @property                                                                            
 359 │ 359 │     def base_version(self) -> str:                                                       
 360 │ 360 │         """The "base version" of the version.                                            
 361 │ 361 │                                                                                          
 362 │ 362 │         >>> Version("1.2.3").base_version                                                
 363 │ 363 │         '1.2.3'                                                                          
 364 │ 364 │         >>> Version("1.2.3+abc").base_version                                            
 365 │ 365 │         '1.2.3'                                                                          
 366 │ 366 │         >>> Version("1!1.2.3dev1+abc").base_version                                      
 367 │ 367 │         '1!1.2.3'                                                                        
 368 │ 368 │                                                                                          
 369 │ 369 │         The "base version" is the public version of the project without any pre or post  
 370 │ 370 │         release markers.                                                                 
 371 │ 371 │         """                                                                              
 372 │ 372 │         parts = []                                                                       
 373 │ 373 │                                                                                          
 374 │ 374 │         # Epoch                                                                          
 375 │ 375 │         if self.epoch != 0:                                                              
 376 │ 376 │             parts.append(f"{self.epoch}!")                                               
 377 │ 377 │                                                                                          
 378 │ 378 │         # Release segment                                                                
 379 │ 379 │         parts.append(".".join(str(x) for x in self.release))                             
 380 │ 380 │                                                                                          
 381 │ 381 │         return "".join(parts)                                                            
 382 │ 382 │                                                                                          
 383 │ 383 │     @property                                                                            
 384 │ 384 │     def is_prerelease(self) -> bool:                                                     
 385 │ 385 │         """Whether this version is a pre-release.                                        
 386 │ 386 │                                                                                          
 387 │ 387 │         >>> Version("1.2.3").is_prerelease                                               
 388 │ 388 │         False                                                                            
 389 │ 389 │         >>> Version("1.2.3a1").is_prerelease                                             
 390 │ 390 │         True                                                                             
 391 │ 391 │         >>> Version("1.2.3b1").is_prerelease                                             
 392 │ 392 │         True                                                                             
 393 │ 393 │         >>> Version("1.2.3rc1").is_prerelease                                            
 394 │ 394 │         True                                                                             
 395 │ 395 │         >>> Version("1.2.3dev1").is_prerelease                                           
 396 │ 396 │         True                                                                             
 397 │ 397 │         """                                                                              
 398 │ 398 │         return self.dev is not None or self.pre is not None                              
 399 │ 399 │                                                                                          
 400 │ 400 │     @property                                                                            
 401 │ 401 │     def is_postrelease(self) -> bool:                                                    
 402 │ 402 │         """Whether this version is a post-release.                                       
 403 │ 403 │                                                                                          
 404 │ 404 │         >>> Version("1.2.3").is_postrelease                                              
 405 │ 405 │         False                                                                            
 406 │ 406 │         >>> Version("1.2.3.post1").is_postrelease                                        
 407 │ 407 │         True                                                                             
 408 │ 408 │         """                                                                              
 409 │ 409 │         return self.post is not None                                                     
 410 │ 410 │                                                                                          
 411 │ 411 │     @property                                                                            
 412 │ 412 │     def is_devrelease(self) -> bool:                                                     
 413 │ 413 │         """Whether this version is a development release.                                
 414 │ 414 │                                                                                          
 415 │ 415 │         >>> Version("1.2.3").is_devrelease                                               
 416 │ 416 │         False                                                                            
 417 │ 417 │         >>> Version("1.2.3.dev1").is_devrelease                                          
 418 │ 418 │         True                                                                             
 419 │ 419 │         """                                                                              
 420 │ 420 │         return self.dev is not None                                                      
 421 │ 421 │                                                                                          
 422 │ 422 │     @property                                                                            
 423 │ 423 │     def major(self) -> int:                                                              
 424 │ 424 │         """The first item of :attr:`release` or ``0`` if unavailable.                    
 425 │ 425 │                                                                                          
 426 │ 426 │         >>> Version("1.2.3").major                                                       
 427 │ 427 │         1                                                                                
 428 │ 428 │         """                                                                              
 429 │ 429 │         return self.release[0] if len(self.release) >= 1 else 0                          
 430 │ 430 │                                                                                          
 431 │ 431 │     @property                                                                            
 432 │ 432 │     def minor(self) -> int:                                                              
 433 │ 433 │         """The second item of :attr:`release` or ``0`` if unavailable.                   
 434 │ 434 │                                                                                          
 435 │ 435 │         >>> Version("1.2.3").minor                                                       
 436 │ 436 │         2                                                                                
 437 │ 437 │         >>> Version("1").minor                                                           
 438 │ 438 │         0                                                                                
 439 │ 439 │         """                                                                              
 440 │ 440 │         return self.release[1] if len(self.release) >= 2 else 0                          
 441 │ 441 │                                                                                          
 442 │ 442 │     @property                                                                            
 443 │ 443 │     def micro(self) -> int:                                                              
 444 │ 444 │         """The third item of :attr:`release` or ``0`` if unavailable.                    
 445 │ 445 │                                                                                          
 446 │ 446 │         >>> Version("1.2.3").micro                                                       
 447 │ 447 │         3                                                                                
 448 │ 448 │         >>> Version("1").micro                                                           
 449 │ 449 │         0                                                                                
 450 │ 450 │         """                                                                              
 451 │ 451 │         return self.release[2] if len(self.release) >= 3 else 0                          
 452 │ 452 │                                                                                          
 453 │ 453 │                                                                                          
 454 │ 454 │ class _TrimmedRelease(Version):                                                          
 455 │ 455 │     @property                                                                            
 456 │ 456 │     def release(self) -> tuple[int, ...]:                                                
 457 │ 457 │         """                                                                              
 458 │ 458 │         Release segment without any trailing zeros.                                      
 459 │ 459 │                                                                                          
 460 │ 460 │         >>> _TrimmedRelease('1.0.0').release                                             
 461 │ 461 │         (1,)                                                                             
 462 │ 462 │         >>> _TrimmedRelease('0.0').release                                               
 463 │ 463 │         (0,)                                                                             
 464 │ 464 │         """                                                                              
 465 │ 465 │         rel = super().release                                                            
 466 │ 466 │         nonzeros = (index for index, val in enumerate(rel) if val)                       
 467 │ 467 │         last_nonzero = max(nonzeros, default=0)                                          
 468 │ 468 │         return rel[: last_nonzero + 1]                                                   
 469 │ 469 │                                                                                          
 470 │ 470 │                                                                                          
 471 │ 471 │ def _parse_letter_version(                                                               
 472 │ 472 │     letter: str | None, number: str | bytes | SupportsInt | None                         
 473 │ 473 │ ) -> tuple[str, int] | None:                                                             
 474 │ 474 │     if letter:                                                                           
 475 │ 475 │         # We consider there to be an implicit 0 in a pre-release if there is             
 476 │ 476 │         # not a numeral associated with it.                                              
 477 │ 477 │         if number is None:                                                               
 478 │ 478 │             number = 0                                                                   
 479 │ 479 │                                                                                          
 480 │ 480 │         # We normalize any letters to their lower case form                              
 481 │ 481 │         letter = letter.lower()                                                          
 482 │ 482 │                                                                                          
 483 │ 483 │         # We consider some words to be alternate spellings of other words and            
 484 │ 484 │         # in those cases we want to normalize the spellings to our preferred             
 485 │ 485 │         # spelling.                                                                      
 486 │ 486 │         if letter == "alpha":                                                            
