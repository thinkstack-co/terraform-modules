 138 │ 138 │     NORMAL_MEM = 0xEE                                                                   
 139 │ 139 │     FINAL_NUN = 0xEF                                                                    
 140 │ 140 │     NORMAL_NUN = 0xF0                                                                   
 141 │ 141 │     FINAL_PE = 0xF3                                                                     
 142 │ 142 │     NORMAL_PE = 0xF4                                                                    
 143 │ 143 │     FINAL_TSADI = 0xF5                                                                  
 144 │ 144 │     NORMAL_TSADI = 0xF6                                                                 
 145 │ 145 │                                                                                         
 146 │ 146 │     # Minimum Visual vs Logical final letter score difference.                          
 147 │ 147 │     # If the difference is below this, don't rely solely on the final letter score      
 148 │ 148 │     # distance.                                                                         
 149 │ 149 │     MIN_FINAL_CHAR_DISTANCE = 5                                                         
 150 │ 150 │                                                                                         
 151 │ 151 │     # Minimum Visual vs Logical model score difference.                                 
 152 │ 152 │     # If the difference is below this, don't rely at all on the model score             
 153 │ 153 │     # distance.                                                                         
 154 │ 154 │     MIN_MODEL_DISTANCE = 0.01                                                           
 155 │ 155 │                                                                                         
 156 │ 156 │     VISUAL_HEBREW_NAME = "ISO-8859-8"                                                   
 157 │ 157 │     LOGICAL_HEBREW_NAME = "windows-1255"                                                
 158 │ 158 │                                                                                         
 159 │ 159 │     def __init__(self) -> None:                                                         
 160 │ 160 │         super().__init__()                                                              
 161 │ 161 │         self._final_char_logical_score = 0                                              
 162 │ 162 │         self._final_char_visual_score = 0                                               
 163 │ 163 │         self._prev = self.SPACE                                                         
 164 │ 164 │         self._before_prev = self.SPACE                                                  
 165 │ 165 │         self._logical_prober: Optional[SingleByteCharSetProber] = None                  
 166 │ 166 │         self._visual_prober: Optional[SingleByteCharSetProber] = None                   
 167 │ 167 │         self.reset()                                                                    
 168 │ 168 │                                                                                         
 169 │ 169 │     def reset(self) -> None:                                                            
 170 │ 170 │         self._final_char_logical_score = 0                                              
 171 │ 171 │         self._final_char_visual_score = 0                                               
 172 │ 172 │         # The two last characters seen in the previous buffer,                          
 173 │ 173 │         # mPrev and mBeforePrev are initialized to space in order to simulate           
 174 │ 174 │         # a word delimiter at the beginning of the data                                 
 175 │ 175 │         self._prev = self.SPACE                                                         
 176 │ 176 │         self._before_prev = self.SPACE                                                  
 177 │ 177 │         # These probers are owned by the group prober.                                  
 178 │ 178 │                                                                                         
 179 │ 179 │     def set_model_probers(                                                              
 180 │ 180 │         self,                                                                           
 181 │ 181 │         logical_prober: SingleByteCharSetProber,                                        
 182 │ 182 │         visual_prober: SingleByteCharSetProber,                                         
 183 │ 183 │     ) -> None:                                                                          
 184 │ 184 │         self._logical_prober = logical_prober                                           
 185 │ 185 │         self._visual_prober = visual_prober                                             
 186 │ 186 │                                                                                         
 187 │ 187 │     def is_final(self, c: int) -> bool:                                                 
 188 │ 188 │         return c in [                                                                   
 189 │ 189 │             self.FINAL_KAF,                                                             
 190 │ 190 │             self.FINAL_MEM,                                                             
 191 │ 191 │             self.FINAL_NUN,                                                             
 192 │ 192 │             self.FINAL_PE,                                                              
 193 │ 193 │             self.FINAL_TSADI,                                                           
 194 │ 194 │         ]                                                                               
 195 │ 195 │                                                                                         
 196 │ 196 │     def is_non_final(self, c: int) -> bool:                                             
 197 │ 197 │         # The normal Tsadi is not a good Non-Final letter due to words like             
 198 │ 198 │         # 'lechotet' (to chat) containing an apostrophe after the tsadi. This           
 199 │ 199 │         # apostrophe is converted to a space in FilterWithoutEnglishLetters             
 200 │ 200 │         # causing the Non-Final tsadi to appear at an end of a word even                
 201 │ 201 │         # though this is not the case in the original text.                             
 202 │ 202 │         # The letters Pe and Kaf rarely display a related behavior of not being         
 203 │ 203 │         # a good Non-Final letter. Words like 'Pop', 'Winamp' and 'Mubarak'             
 204 │ 204 │         # for example legally end with a Non-Final Pe or Kaf. However, the              
 205 │ 205 │         # benefit of these letters as Non-Final letters outweighs the damage            
 206 │ 206 │         # since these words are quite rare.                                             
 207 │ 207 │         return c in [self.NORMAL_KAF, self.NORMAL_MEM, self.NORMAL_NUN, self.NORMAL_PE] 
