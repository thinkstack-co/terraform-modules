 187 │ 187 │ class MorphOp:                                                                          
 188 │ 188 │     """A class for binary morphological operators"""                                    
 189 │ 189 │                                                                                         
 190 │ 190 │     def __init__(                                                                       
 191 │ 191 │         self,                                                                           
 192 │ 192 │         lut: bytearray | None = None,                                                   
 193 │ 193 │         op_name: str | None = None,                                                     
 194 │ 194 │         patterns: list[str] | None = None,                                              
 195 │ 195 │     ) -> None:                                                                          
 196 │ 196 │         """Create a binary morphological operator"""                                    
 197 │ 197 │         self.lut = lut                                                                  
 198 │ 198 │         if op_name is not None:                                                         
 199 │ 199 │             self.lut = LutBuilder(op_name=op_name).build_lut()                          
 200 │ 200 │         elif patterns is not None:                                                      
 201 │ 201 │             self.lut = LutBuilder(patterns=patterns).build_lut()                        
 202 │ 202 │                                                                                         
 203 │ 203 │     def apply(self, image: Image.Image) -> tuple[int, Image.Image]:                     
 204 │ 204 │         """Run a single morphological operation on an image                             
 205 │ 205 │                                                                                         
 206 │ 206 │         Returns a tuple of the number of changed pixels and the                         
 207 │ 207 │         morphed image"""                                                                
 208 │ 208 │         if self.lut is None:                                                            
 209 │ 209 │             msg = "No operator loaded"                                                  
 210 │ 210 │             raise Exception(msg)                                                        
 211 │ 211 │                                                                                         
 212 │ 212 │         if image.mode != "L":                                                           
 213 │ 213 │             msg = "Image mode must be L"                                                
 214 │ 214 │             raise ValueError(msg)                                                       
 215 │ 215 │         outimage = Image.new(image.mode, image.size, None)                              
 216 │ 216 │         count = _imagingmorph.apply(bytes(self.lut), image.getim(), outimage.getim())   
 217 │ 217 │         return count, outimage                                                          
 218 │ 218 │                                                                                         
 219 │ 219 │     def match(self, image: Image.Image) -> list[tuple[int, int]]:                       
 220 │ 220 │         """Get a list of coordinates matching the morphological operation on            
 221 │ 221 │         an image.                                                                       
 222 │ 222 │                                                                                         
 223 │ 223 │         Returns a list of tuples of (x,y) coordinates                                   
 224 │ 224 │         of all matching pixels. See :ref:`coordinate-system`."""                        
 225 │ 225 │         if self.lut is None:                                                            
 226 │ 226 │             msg = "No operator loaded"                                                  
 227 │ 227 │             raise Exception(msg)                                                        
 228 │ 228 │                                                                                         
 229 │ 229 │         if image.mode != "L":                                                           
 230 │ 230 │             msg = "Image mode must be L"                                                
 231 │ 231 │             raise ValueError(msg)                                                       
 232 │ 232 │         return _imagingmorph.match(bytes(self.lut), image.getim())                      
 233 │ 233 │                                                                                         
 234 │ 234 │     def get_on_pixels(self, image: Image.Image) -> list[tuple[int, int]]:               
 235 │ 235 │         """Get a list of all turned on pixels in a binary image                         
 236 │ 236 │                                                                                         
 237 │ 237 │         Returns a list of tuples of (x,y) coordinates                                   
 238 │ 238 │         of all matching pixels. See :ref:`coordinate-system`."""                        
 239 │ 239 │                                                                                         
 240 │ 240 │         if image.mode != "L":                                                           
 241 │ 241 │             msg = "Image mode must be L"                                                
 242 │ 242 │             raise ValueError(msg)                                                       
 243 │ 243 │         return _imagingmorph.get_on_pixels(image.getim())                               
 244 │ 244 │                                                                                         
 245 │ 245 │     def load_lut(self, filename: str) -> None:                                          
 246 │ 246 │         """Load an operator from an mrl file"""                                         
 247 │ 247 │         with open(filename, "rb") as f:                                                 
 248 │ 248 │             self.lut = bytearray(f.read())                                              
 249 │ 249 │                                                                                         
 250 │ 250 │         if len(self.lut) != LUT_SIZE:                                                   
