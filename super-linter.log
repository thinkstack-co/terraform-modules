 234 │ 234 │         """                                                                                         
 235 │ 235 │         Upload a release file to the index.                                                         
 236 │ 236 │                                                                                                     
 237 │ 237 │         :param metadata: A :class:`Metadata` instance defining at least a name                      
 238 │ 238 │                          and version number for the file to be uploaded.                            
 239 │ 239 │         :param filename: The pathname of the file to be uploaded.                                   
 240 │ 240 │         :param signer: The identifier of the signer of the file.                                    
 241 │ 241 │         :param sign_password: The passphrase for the signer's                                       
 242 │ 242 │                               private key used for signing.                                         
 243 │ 243 │         :param filetype: The type of the file being uploaded. This is the                           
 244 │ 244 │                         distutils command which produced that file, e.g.                            
 245 │ 245 │                         ``sdist`` or ``bdist_wheel``.                                               
 246 │ 246 │         :param pyversion: The version of Python which the release relates                           
 247 │ 247 │                           to. For code compatible with any Python, this would                       
 248 │ 248 │                           be ``source``, otherwise it would be e.g. ``3.2``.                        
 249 │ 249 │         :param keystore: The path to a directory which contains the keys                            
 250 │ 250 │                          used in signing. If not specified, the instance's                          
 251 │ 251 │                          ``gpg_home`` attribute is used instead.                                    
 252 │ 252 │         :return: The HTTP response received from PyPI upon submission of the                        
 253 │ 253 │                 request.                                                                            
 254 │ 254 │         """                                                                                         
 255 │ 255 │         self.check_credentials()                                                                    
 256 │ 256 │         if not os.path.exists(filename):                                                            
 257 │ 257 │             raise DistlibException('not found: %s' % filename)                                      
 258 │ 258 │         metadata.validate()                                                                         
 259 │ 259 │         d = metadata.todict()                                                                       
 260 │ 260 │         sig_file = None                                                                             
 261 │ 261 │         if signer:                                                                                  
 262 │ 262 │             if not self.gpg:                                                                        
 263 │ 263 │                 logger.warning('no signing program available - not signed')                         
 264 │ 264 │             else:                                                                                   
 265 │ 265 │                 sig_file = self.sign_file(filename, signer, sign_password,                          
 266 │ 266 │                                           keystore)                                                 
 267 │ 267 │         with open(filename, 'rb') as f:                                                             
 268 │ 268 │             file_data = f.read()                                                                    
 269 │ 269 │         md5_digest = hashlib.md5(file_data).hexdigest()                                             
 270 │ 270 │         sha256_digest = hashlib.sha256(file_data).hexdigest()                                       
 271 │ 271 │         d.update({                                                                                  
 272 │ 272 │             ':action': 'file_upload',                                                               
 273 │ 273 │             'protocol_version': '1',                                                                
 274 │ 274 │             'filetype': filetype,                                                                   
 275 │ 275 │             'pyversion': pyversion,                                                                 
 276 │ 276 │             'md5_digest': md5_digest,                                                               
 277 │ 277 │             'sha256_digest': sha256_digest,                                                         
 278 │ 278 │         })                                                                                          
 279 │ 279 │         files = [('content', os.path.basename(filename), file_data)]                                
 280 │ 280 │         if sig_file:                                                                                
 281 │ 281 │             with open(sig_file, 'rb') as f:                                                         
 282 │ 282 │                 sig_data = f.read()                                                                 
 283 │ 283 │             files.append(('gpg_signature', os.path.basename(sig_file),                              
 284 │ 284 │                          sig_data))                                                                 
 285 │ 285 │             shutil.rmtree(os.path.dirname(sig_file))                                                
 286 │ 286 │         request = self.encode_request(d.items(), files)                                             
 287 │ 287 │         return self.send_request(request)                                                           
 288 │ 288 │                                                                                                     
 289 │ 289 │     def upload_documentation(self, metadata, doc_dir):  # pragma: no cover                          
 290 │ 290 │         """                                                                                         
 291 │ 291 │         Upload documentation to the index.                                                          
 292 │ 292 │                                                                                                     
 293 │ 293 │         :param metadata: A :class:`Metadata` instance defining at least a name                      
 294 │ 294 │                          and version number for the documentation to be                             
 295 │ 295 │                          uploaded.                                                                  
 296 │ 296 │         :param doc_dir: The pathname of the directory which contains the                            
 297 │ 297 │                         documentation. This should be the directory that                            
 298 │ 298 │                         contains the ``index.html`` for the documentation.                          
 299 │ 299 │         :return: The HTTP response received from PyPI upon submission of the                        
 300 │ 300 │                 request.                                                                            
 301 │ 301 │         """                                                                                         
 302 │ 302 │         self.check_credentials()                                                                    
 303 │ 303 │         if not os.path.isdir(doc_dir):                                                              
 304 │ 304 │             raise DistlibException('not a directory: %r' % doc_dir)                                 
 305 │ 305 │         fn = os.path.join(doc_dir, 'index.html')                                                    
 306 │ 306 │         if not os.path.exists(fn):                                                                  
 307 │ 307 │             raise DistlibException('not found: %r' % fn)                                            
 308 │ 308 │         metadata.validate()                                                                         
 309 │ 309 │         name, version = metadata.name, metadata.version                                             
 310 │ 310 │         zip_data = zip_dir(doc_dir).getvalue()                                                      
 311 │ 311 │         fields = [(':action', 'doc_upload'),                                                        
 312 │ 312 │                   ('name', name), ('version', version)]                                             
 313 │ 313 │         files = [('content', name, zip_data)]                                                       
 314 │ 314 │         request = self.encode_request(fields, files)                                                
 315 │ 315 │         return self.send_request(request)                                                           
