 315 │ 315 │ def _py_interpreter_range(py_version: PythonVersion) -> Iterator[str]:                     
 316 │ 316 │     """                                                                                    
 317 │ 317 │     Yields Python versions in descending order.                                            
 318 │ 318 │                                                                                            
 319 │ 319 │     After the latest version, the major-only version will be yielded, and then             
 320 │ 320 │     all previous versions of that major version.                                           
 321 │ 321 │     """                                                                                    
 322 │ 322 │     if len(py_version) > 1:                                                                
 323 │ 323 │         yield f"py{_version_nodot(py_version[:2])}"                                        
 324 │ 324 │     yield f"py{py_version[0]}"                                                             
 325 │ 325 │     if len(py_version) > 1:                                                                
 326 │ 326 │         for minor in range(py_version[1] - 1, -1, -1):                                     
 327 │ 327 │             yield f"py{_version_nodot((py_version[0], minor))}"                            
 328 │ 328 │                                                                                            
