 149 │ 149 │ ]:                                                                                       
 150 │ 150 │     """Parse the JP2 header box to extract size, component count,                        
 151 │ 151 │     color space information, and optionally DPI information,                             
 152 │ 152 │     returning a (size, mode, mimetype, dpi) tuple."""                                    
 153 │ 153 │                                                                                          
 154 │ 154 │     # Find the JP2 header box                                                            
 155 │ 155 │     reader = BoxReader(fp)                                                               
 156 │ 156 │     header = None                                                                        
 157 │ 157 │     mimetype = None                                                                      
 158 │ 158 │     while reader.has_next_box():                                                         
 159 │ 159 │         tbox = reader.next_box_type()                                                    
 160 │ 160 │                                                                                          
 161 │ 161 │         if tbox == b"jp2h":                                                              
 162 │ 162 │             header = reader.read_boxes()                                                 
 163 │ 163 │             break                                                                        
 164 │ 164 │         elif tbox == b"ftyp":                                                            
 165 │ 165 │             if reader.read_fields(">4s")[0] == b"jpx ":                                  
 166 │ 166 │                 mimetype = "image/jpx"                                                   
 167 │ 167 │     assert header is not None                                                            
 168 │ 168 │                                                                                          
 169 │ 169 │     size = None                                                                          
 170 │ 170 │     mode = None                                                                          
 171 │ 171 │     bpc = None                                                                           
 172 │ 172 │     nc = None                                                                            
 173 │ 173 │     dpi = None  # 2-tuple of DPI info, or None                                           
 174 │ 174 │     palette = None                                                                       
 175 │ 175 │                                                                                          
 176 │ 176 │     while header.has_next_box():                                                         
 177 │ 177 │         tbox = header.next_box_type()                                                    
 178 │ 178 │                                                                                          
 179 │ 179 │         if tbox == b"ihdr":                                                              
 180 │ 180 │             height, width, nc, bpc = header.read_fields(">IIHB")                         
 181 │ 181 │             assert isinstance(height, int)                                               
 182 │ 182 │             assert isinstance(width, int)                                                
 183 │ 183 │             assert isinstance(bpc, int)                                                  
 184 │ 184 │             size = (width, height)                                                       
 185 │ 185 │             if nc == 1 and (bpc & 0x7F) > 8:                                             
 186 │ 186 │                 mode = "I;16"                                                            
 187 │ 187 │             elif nc == 1:                                                                
 188 │ 188 │                 mode = "L"                                                               
 189 │ 189 │             elif nc == 2:                                                                
 190 │ 190 │                 mode = "LA"                                                              
 191 │ 191 │             elif nc == 3:                                                                
 192 │ 192 │                 mode = "RGB"                                                             
 193 │ 193 │             elif nc == 4:                                                                
 194 │ 194 │                 mode = "RGBA"                                                            
 195 │ 195 │         elif tbox == b"colr" and nc == 4:                                                
 196 │ 196 │             meth, _, _, enumcs = header.read_fields(">BBBI")                             
 197 │ 197 │             if meth == 1 and enumcs == 12:                                               
 198 │ 198 │                 mode = "CMYK"                                                            
 199 │ 199 │         elif tbox == b"pclr" and mode in ("L", "LA"):                                    
 200 │ 200 │             ne, npc = header.read_fields(">HB")                                          
 201 │ 201 │             assert isinstance(ne, int)                                                   
 202 │ 202 │             assert isinstance(npc, int)                                                  
 203 │ 203 │             max_bitdepth = 0                                                             
 204 │ 204 │             for bitdepth in header.read_fields(">" + ("B" * npc)):                       
 205 │ 205 │                 assert isinstance(bitdepth, int)                                         
 206 │ 206 │                 if bitdepth > max_bitdepth:                                              
 207 │ 207 │                     max_bitdepth = bitdepth                                              
 208 │ 208 │             if max_bitdepth <= 8:                                                        
 209 │ 209 │                 palette = ImagePalette.ImagePalette("RGBA" if npc == 4 else "RGB")       
 210 │ 210 │                 for i in range(ne):                                                      
 211 │ 211 │                     color: list[int] = []                                                
 212 │ 212 │                     for value in header.read_fields(">" + ("B" * npc)):                  
 213 │ 213 │                         assert isinstance(value, int)                                    
 214 │ 214 │                         color.append(value)                                              
 215 │ 215 │                     palette.getcolor(tuple(color))                                       
 216 │ 216 │                 mode = "P" if mode == "L" else "PA"                                      
 217 │ 217 │         elif tbox == b"res ":                                                            
 218 │ 218 │             res = header.read_boxes()                                                    
 219 │ 219 │             while res.has_next_box():                                                    
 220 │ 220 │                 tres = res.next_box_type()                                               
 221 │ 221 │                 if tres == b"resc":                                                      
 222 │ 222 │                     vrcn, vrcd, hrcn, hrcd, vrce, hrce = res.read_fields(">HHHHBB")      
 223 │ 223 │                     assert isinstance(vrcn, int)                                         
 224 │ 224 │                     assert isinstance(vrcd, int)                                         
 225 │ 225 │                     assert isinstance(hrcn, int)                                         
 226 │ 226 │                     assert isinstance(hrcd, int)                                         
 227 │ 227 │                     assert isinstance(vrce, int)                                         
 228 │ 228 │                     assert isinstance(hrce, int)                                         
 229 │ 229 │                     hres = _res_to_dpi(hrcn, hrcd, hrce)                                 
 230 │ 230 │                     vres = _res_to_dpi(vrcn, vrcd, vrce)                                 
 231 │ 231 │                     if hres is not None and vres is not None:                            
 232 │ 232 │                         dpi = (hres, vres)                                               
 233 │ 233 │                     break                                                                
 234 │ 234 │                                                                                          
 235 │ 235 │     if size is None or mode is None:                                                     
 236 │ 236 │         msg = "Malformed JP2 header"                                                     
 237 │ 237 │         raise SyntaxError(msg)                                                           
 238 │ 238 │                                                                                          
 239 │ 239 │     return size, mode, mimetype, dpi, palette                                            
