 93  │ 93  │     def is_likely_utf32be(self) -> bool:                                         
 94  │ 94  │         approx_chars = self.approx_32bit_chars()                                 
 95  │ 95  │         return approx_chars >= self.MIN_CHARS_FOR_DETECTION and (                
 96  │ 96  │             self.zeros_at_mod[0] / approx_chars > self.EXPECTED_RATIO            
