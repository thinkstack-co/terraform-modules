 476 │ 476 │ def ios_platforms(                                                                         
 477 │ 477 │     version: AppleVersion | None = None, multiarch: str | None = None                      
 478 │ 478 │ ) -> Iterator[str]:                                                                        
 479 │ 479 │     """                                                                                    
 480 │ 480 │     Yields the platform tags for an iOS system.                                            
 481 │ 481 │                                                                                            
 482 │ 482 │     :param version: A two-item tuple specifying the iOS version to generate                
 483 │ 483 │         platform tags for. Defaults to the current iOS version.                            
 484 │ 484 │     :param multiarch: The CPU architecture+ABI to generate platform tags for -             
 485 │ 485 │         (the value used by `sys.implementation._multiarch` e.g.,                           
 486 │ 486 │         `arm64_iphoneos` or `x84_64_iphonesimulator`). Defaults to the current             
 487 │ 487 │         multiarch value.                                                                   
 488 │ 488 │     """                                                                                    
 489 │ 489 │     if version is None:                                                                    
 490 │ 490 │         # if iOS is the current platform, ios_ver *must* be defined. However,              
 491 │ 491 │         # it won't exist for CPython versions before 3.13, which causes a mypy             
 492 │ 492 │         # error.                                                                           
 493 │ 493 │         _, release, _, _ = platform.ios_ver()  # type: ignore[attr-defined, unused-ignore] 
 494 │ 494 │         version = cast("AppleVersion", tuple(map(int, release.split(".")[:2])))            
 495 │ 495 │                                                                                            
 496 │ 496 │     if multiarch is None:                                                                  
 497 │ 497 │         multiarch = sys.implementation._multiarch                                          
 498 │ 498 │     multiarch = multiarch.replace("-", "_")                                                
 499 │ 499 │                                                                                            
 500 │ 500 │     ios_platform_template = "ios_{major}_{minor}_{multiarch}"                              
 501 │ 501 │                                                                                            
 502 │ 502 │     # Consider any iOS major.minor version from the version requested, down to             
 503 │ 503 │     # 12.0. 12.0 is the first iOS version that is known to have enough features            
 504 │ 504 │     # to support CPython. Consider every possible minor release up to X.9. There           
 505 │ 505 │     # highest the minor has ever gone is 8 (14.8 and 15.8) but having some extra           
 506 │ 506 │     # candidates that won't ever match doesn't really hurt, and it saves us from           
 507 │ 507 │     # having to keep an explicit list of known iOS versions in the code. Return            
 508 │ 508 │     # the results descending order of version number.                                      
 509 │ 509 │                                                                                            
 510 │ 510 │     # If the requested major version is less than 12, there won't be any matches.          
 511 │ 511 │     if version[0] < 12:                                                                    
 512 │ 512 │         return                                                                             
 513 │ 513 │                                                                                            
 514 │ 514 │     # Consider the actual X.Y version that was requested.                                  
 515 │ 515 │     yield ios_platform_template.format(                                                    
 516 │ 516 │         major=version[0], minor=version[1], multiarch=multiarch                            
 517 │ 517 │     )                                                                                      
 518 │ 518 │                                                                                            
 519 │ 519 │     # Consider every minor version from X.0 to the minor version prior to the              
 520 │ 520 │     # version requested by the platform.                                                   
 521 │ 521 │     for minor in range(version[1] - 1, -1, -1):                                            
 522 │ 522 │         yield ios_platform_template.format(                                                
 523 │ 523 │             major=version[0], minor=minor, multiarch=multiarch                             
 524 │ 524 │         )                                                                                  
 525 │ 525 │                                                                                            
 526 │ 526 │     for major in range(version[0] - 1, 11, -1):                                            
 527 │ 527 │         for minor in range(9, -1, -1):                                                     
 528 │ 528 │             yield ios_platform_template.format(                                            
 529 │ 529 │                 major=major, minor=minor, multiarch=multiarch                              
 530 │ 530 │             )                                                                              
 531 │ 531 │                                                                                            
