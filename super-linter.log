 392 │ 378 │ def scale(                                                                              
 393 │ 379 │     image: Image.Image, factor: float, resample: int = Image.Resampling.BICUBIC         
 394 │ 380 │ ) -> Image.Image:                                                                       
 395 │ 381 │     """                                                                                 
 396 │ 382 │     Returns a rescaled image by a specific factor given in parameter.                   
 397 │ 383 │     A factor greater than 1 expands the image, between 0 and 1 contracts the            
 398 │ 384 │     image.                                                                              
 399 │ 385 │                                                                                         
 400 │ 386 │     :param image: The image to rescale.                                                 
 401 │ 387 │     :param factor: The expansion factor, as a float.                                    
 402 │ 388 │     :param resample: Resampling method to use. Default is                               
 403 │ 389 │                      :py:attr:`~PIL.Image.Resampling.BICUBIC`.                          
 404 │ 390 │                      See :ref:`concept-filters`.                                        
 405 │ 391 │     :returns: An :py:class:`~PIL.Image.Image` object.                                   
 406 │ 392 │     """                                                                                 
 407 │ 393 │     if factor == 1:                                                                     
 408 │ 394 │         return image.copy()                                                             
 409 │ 395 │     elif factor <= 0:                                                                   
 410 │ 396 │         msg = "the factor must be greater than 0"                                       
 411 │ 397 │         raise ValueError(msg)                                                           
 412 │ 398 │     else:                                                                               
 413 │ 399 │         size = (round(factor * image.width), round(factor * image.height))              
 414 │ 400 │         return image.resize(size, resample)                                             
