 35 │ 35 │                                                                        
 36 │ 36 │ class UTF8Prober(CharSetProber):                                       
 37 │ 37 │     ONE_CHAR_PROB = 0.5                                                
 38 │ 38 │                                                                        
 39 │ 39 │     def __init__(self) -> None:                                        
 40 │ 40 │         super().__init__()                                             
 41 │ 41 │         self.coding_sm = CodingStateMachine(UTF8_SM_MODEL)             
 42 │ 42 │         self._num_mb_chars = 0                                         
 43 │ 43 │         self.reset()                                                   
 44 │ 44 │                                                                        
 45 │ 45 │     def reset(self) -> None:                                           
 46 │ 46 │         super().reset()                                                
 47 │ 47 │         self.coding_sm.reset()                                         
 48 │ 48 │         self._num_mb_chars = 0                                         
