 120 │ 120 │ class JapaneseContextAnalysis:                                                                                                                                                                                                                                 
 121 │ 121 │     NUM_OF_CATEGORY = 6                                                                                                                                                                                                                                        
 122 │ 122 │     DONT_KNOW = -1                                                                                                                                                                                                                                             
 123 │ 123 │     ENOUGH_REL_THRESHOLD = 100                                                                                                                                                                                                                                 
 124 │ 124 │     MAX_REL_THRESHOLD = 1000                                                                                                                                                                                                                                   
 125 │ 125 │     MINIMUM_DATA_THRESHOLD = 4                                                                                                                                                                                                                                 
 126 │ 126 │                                                                                                                                                                                                                                                                
 127 │ 127 │     def __init__(self) -> None:                                                                                                                                                                                                                                
 128 │ 128 │         self._total_rel = 0                                                                                                                                                                                                                                    
 129 │ 129 │         self._rel_sample: List[int] = []                                                                                                                                                                                                                       
 130 │ 130 │         self._need_to_skip_char_num = 0                                                                                                                                                                                                                        
 131 │ 131 │         self._last_char_order = -1                                                                                                                                                                                                                             
 132 │ 132 │         self._done = False                                                                                                                                                                                                                                     
 133 │ 133 │         self.reset()                                                                                                                                                                                                                                           
 134 │ 134 │                                                                                                                                                                                                                                                                
 135 │ 135 │     def reset(self) -> None:                                                                                                                                                                                                                                   
 136 │ 136 │         self._total_rel = 0  # total sequence received                                                                                                                                                                                                         
 137 │ 137 │         # category counters, each integer counts sequence in its category                                                                                                                                                                                      
 138 │ 138 │         self._rel_sample = [0] * self.NUM_OF_CATEGORY                                                                                                                                                                                                          
 139 │ 139 │         # if last byte in current buffer is not the last byte of a character,                                                                                                                                                                                  
 140 │ 140 │         # we need to know how many bytes to skip in next buffer                                                                                                                                                                                                
 141 │ 141 │         self._need_to_skip_char_num = 0                                                                                                                                                                                                                        
 142 │ 142 │         self._last_char_order = -1  # The order of previous char                                                                                                                                                                                               
 143 │ 143 │         # If this flag is set to True, detection is done and conclusion has                                                                                                                                                                                    
 144 │ 144 │         # been made                                                                                                                                                                                                                                            
 145 │ 145 │         self._done = False                                                                                                                                                                                                                                     
 146 │ 146 │                                                                                                                                                                                                                                                                
 147 │ 147 │     def feed(self, byte_str: Union[bytes, bytearray], num_bytes: int) -> None:                                                                                                                                                                                 
 148 │ 148 │         if self._done:                                                                                                                                                                                                                                         
 149 │ 149 │             return                                                                                                                                                                                                                                             
 150 │ 150 │                                                                                                                                                                                                                                                                
 151 │ 151 │         # The buffer we got is byte oriented, and a character may span in more than one                                                                                                                                                                        
 152 │ 152 │         # buffers. In case the last one or two byte in last buffer is not                                                                                                                                                                                      
 153 │ 153 │         # complete, we record how many byte needed to complete that character                                                                                                                                                                                  
 154 │ 154 │         # and skip these bytes here.  We can choose to record those bytes as                                                                                                                                                                                   
 155 │ 155 │         # well and analyse the character once it is complete, but since a                                                                                                                                                                                      
 156 │ 156 │         # character will not make much difference, by simply skipping                                                                                                                                                                                          
 157 │ 157 │         # this character will simply our logic and improve performance.                                                                                                                                                                                        
 158 │ 158 │         i = self._need_to_skip_char_num                                                                                                                                                                                                                        
 159 │ 159 │         while i < num_bytes:                                                                                                                                                                                                                                   
 160 │ 160 │             order, char_len = self.get_order(byte_str[i : i + 2])                                                                                                                                                                                              
 161 │ 161 │             i += char_len                                                                                                                                                                                                                                      
 162 │ 162 │             if i > num_bytes:                                                                                                                                                                                                                                  
 163 │ 163 │                 self._need_to_skip_char_num = i - num_bytes                                                                                                                                                                                                    
 164 │ 164 │                 self._last_char_order = -1                                                                                                                                                                                                                     
 165 │ 165 │             else:                                                                                                                                                                                                                                              
 166 │ 166 │                 if (order != -1) and (self._last_char_order != -1):                                                                                                                                                                                            
 167 │ 167 │                     self._total_rel += 1                                                                                                                                                                                                                       
 168 │ 168 │                     if self._total_rel > self.MAX_REL_THRESHOLD:                                                                                                                                                                                               
 169 │ 169 │                         self._done = True                                                                                                                                                                                                                      
 170 │ 170 │                         break                                                                                                                                                                                                                                  
 171 │ 171 │                     self._rel_sample[                                                                                                                                                                                                                          
 172 │ 172 │                         jp2_char_context[self._last_char_order][order]                                                                                                                                                                                         
 173 │ 173 │                     ] += 1                                                                                                                                                                                                                                     
 174 │ 174 │                 self._last_char_order = order                                                                                                                                                                                                                  
 175 │ 175 │                                                                                                                                                                                                                                                                
 176 │ 176 │     def got_enough_data(self) -> bool:                                                                                                                                                                                                                         
 177 │ 177 │         return self._total_rel > self.ENOUGH_REL_THRESHOLD                                                                                                                                                                                                     
 178 │ 178 │                                                                                                                                                                                                                                                                
 179 │ 179 │     def get_confidence(self) -> float:                                                                                                                                                                                                                         
 180 │ 180 │         # This is just one way to calculate confidence. It works well for me.                                                                                                                                                                                  
 181 │ 181 │         if self._total_rel > self.MINIMUM_DATA_THRESHOLD:                                                                                                                                                                                                      
 182 │ 182 │             return (self._total_rel - self._rel_sample[0]) / self._total_rel                                                                                                                                                                                   
 183 │ 183 │         return self.DONT_KNOW                                                                                                                                                                                                                                  
 184 │ 184 │                                                                                                                                                                                                                                                                
 185 │ 185 │     def get_order(self, _: Union[bytes, bytearray]) -> Tuple[int, int]:                                                                                                                                                                                        
 186 │ 186 │         return -1, 1                                                                                                                                                                                                                                           
 187 │ 187 │                                                                                                                                                                                                                                                                
 188 │ 188 │                                                                                                                                                                                                                                                                
 189 │ 189 │ class SJISContextAnalysis(JapaneseContextAnalysis):                                                                                                                                                                                                            
 190 │ 190 │     def __init__(self) -> None:                                                                                                                                                                                                                                
 191 │ 191 │         super().__init__()                                                                                                                                                                                                                                     
 192 │ 192 │         self._charset_name = "SHIFT_JIS"                                                                                                                                                                                                                       
 193 │ 193 │                                                                                                                                                                                                                                                                
 194 │ 194 │     @property                                                                                                                                                                                                                                                  
 195 │ 195 │     def charset_name(self) -> str:                                                                                                                                                                                                                             
 196 │ 196 │         return self._charset_name                                                                                                                                                                                                                              
 197 │ 197 │                                                                                                                                                                                                                                                                
 198 │ 198 │     def get_order(self, byte_str: Union[bytes, bytearray]) -> Tuple[int, int]:                                                                                                                                                                                 
 199 │ 199 │         if not byte_str:                                                                                                                                                                                                                                       
 200 │ 200 │             return -1, 1                                                                                                                                                                                                                                       
 201 │ 201 │         # find out current char's byte length                                                                                                                                                                                                                  
 202 │ 202 │         first_char = byte_str[0]                                                                                                                                                                                                                               
 203 │ 203 │         if (0x81 <= first_char <= 0x9F) or (0xE0 <= first_char <= 0xFC):                                                                                                                                                                                       
 204 │ 204 │             char_len = 2                                                                                                                                                                                                                                       
 205 │ 205 │             if (first_char == 0x87) or (0xFA <= first_char <= 0xFC):                                                                                                                                                                                           
 206 │ 206 │                 self._charset_name = "CP932"                                                                                                                                                                                                                   
 207 │ 207 │         else:                                                                                                                                                                                                                                                  
 208 │ 208 │             char_len = 1                                                                                                                                                                                                                                       
 209 │ 209 │                                                                                                                                                                                                                                                                
 210 │ 210 │         # return its order if it is hiragana                                                                                                                                                                                                                   
 211 │ 211 │         if len(byte_str) > 1:                                                                                                                                                                                                                                  
 212 │ 212 │             second_char = byte_str[1]                                                                                                                                                                                                                          
 213 │ 213 │             if (first_char == 202) and (0x9F <= second_char <= 0xF1):                                                                                                                                                                                          
 214 │ 214 │                 return second_char - 0x9F, char_len                                                                                                                                                                                                            
 215 │ 215 │                                                                                                                                                                                                                                                                
 216 │ 216 │         return -1, char_len                                                                                                                                                                                                                                    
 217 │ 217 │                                                                                                                                                                                                                                                                
 218 │ 218 │                                                                                                                                                                                                                                                                
 219 │ 219 │ class EUCJPContextAnalysis(JapaneseContextAnalysis):                                                                                                                                                                                                           
 220 │ 220 │     def get_order(self, byte_str: Union[bytes, bytearray]) -> Tuple[int, int]:                                                                                                                                                                                 
 221 │ 221 │         if not byte_str:                                                                                                                                                                                                                                       
 222 │ 222 │             return -1, 1                                                                                                                                                                                                                                       
 223 │ 223 │         # find out current char's byte length                                                                                                                                                                                                                  
 224 │ 224 │         first_char = byte_str[0]                                                                                                                                                                                                                               
 225 │ 225 │         if (first_char == 0x8E) or (0xA1 <= first_char <= 0xFE):                                                                                                                                                                                               
 226 │ 226 │             char_len = 2                                                                                                                                                                                                                                       
 227 │ 227 │         elif first_char == 0x8F:                                                                                                                                                                                                                               
 228 │ 228 │             char_len = 3                                                                                                                                                                                                                                       
 229 │ 229 │         else:                                                                                                                                                                                                                                                  
 230 │ 230 │             char_len = 1                                                                                                                                                                                                                                       
 231 │ 231 │                                                                                                                                                                                                                                                                
 232 │ 232 │         # return its order if it is hiragana                                                                                                                                                                                                                   
 233 │ 233 │         if len(byte_str) > 1:                                                                                                                                                                                                                                  
 234 │ 234 │             second_char = byte_str[1]                                                                                                                                                                                                                          
 235 │ 235 │             if (first_char == 0xA4) and (0xA1 <= second_char <= 0xF3):                                                                                                                                                                                         
 236 │ 236 │                 return second_char - 0xA1, char_len                                                                                                                                                                                                            
 237 │ 237 │                                                                                                                                                                                                                                                                
 238 │ 238 │         return -1, char_len                                                                                                                                                                                                                                    

