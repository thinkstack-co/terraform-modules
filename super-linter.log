 32 │ 32 │                                                                                  
 33 │ 33 │                                                                                  
 34 │ 34 │ class CodingStateMachine:                                                        
 35 │ 35 │     """                                                                          
 36 │ 36 │     A state machine to verify a byte sequence for a particular encoding. For     
 37 │ 37 │     each byte the detector receives, it will feed that byte to every active      
 38 │ 38 │     state machine available, one byte at a time. The state machine changes its   
 39 │ 39 │     state based on its previous state and the byte it receives. There are 3      
 40 │ 40 │     states in a state machine that are of interest to an auto-detector:          
 41 │ 41 │                                                                                  
 42 │ 42 │     START state: This is the state to start with, or a legal byte sequence       
 43 │ 43 │                  (i.e. a valid code point) for character has been identified.    
 44 │ 44 │                                                                                  
 45 │ 45 │     ME state:  This indicates that the state machine identified a byte sequence  
 46 │ 46 │                that is specific to the charset it is designed for and that       
 47 │ 47 │                there is no other possible encoding which can contain this byte   
 48 │ 48 │                sequence. This will to lead to an immediate positive answer for   
 49 │ 49 │                the detector.                                                     
 50 │ 50 │                                                                                  
 51 │ 51 │     ERROR state: This indicates the state machine identified an illegal byte     
 52 │ 52 │                  sequence for that encoding. This will lead to an immediate      
 53 │ 53 │                  negative answer for this encoding. Detector will exclude this   
 54 │ 54 │                  encoding from consideration from here on.                       
 55 │ 55 │     """                                                                          
 56 │ 56 │                                                                                  
 57 │ 57 │     def __init__(self, sm: CodingStateMachineDict) -> None:                      
 58 │ 58 │         self._model = sm                                                         
 59 │ 59 │         self._curr_byte_pos = 0                                                  
 60 │ 60 │         self._curr_char_len = 0                                                  
 61 │ 61 │         self._curr_state = MachineState.START                                    
 62 │ 62 │         self.active = True                                                       
 63 │ 63 │         self.logger = logging.getLogger(__name__)                                
 64 │ 64 │         self.reset()                                                             
 65 │ 65 │                                                                                  
 66 │ 66 │     def reset(self) -> None:                                                     
 67 │ 67 │         self._curr_state = MachineState.START                                    
 68 │ 68 │                                                                                  
 69 │ 69 │     def next_state(self, c: int) -> int:                                         
 70 │ 70 │         # for each byte we get its class                                         
 71 │ 71 │         # if it is first byte, we also get byte length                           
 72 │ 72 │         byte_class = self._model["class_table"][c]                               
 73 │ 73 │         if self._curr_state == MachineState.START:                               
 74 │ 74 │             self._curr_byte_pos = 0                                              
 75 │ 75 │             self._curr_char_len = self._model["char_len_table"][byte_class]      
 76 │ 76 │         # from byte's class and state_table, we get its next state               
 77 │ 77 │         curr_state = self._curr_state * self._model["class_factor"] + byte_class 
 78 │ 78 │         self._curr_state = self._model["state_table"][curr_state]                
 79 │ 79 │         self._curr_byte_pos += 1                                                 
 80 │ 80 │         return self._curr_state                                                  
 81 │ 81 │                                                                                  
 82 │ 82 │     def get_current_charlen(self) -> int:                                        
 83 │ 83 │         return self._curr_char_len                                               
 84 │ 84 │                                                                                  
 85 │ 85 │     def get_coding_state_machine(self) -> str:                                   
 86 │ 86 │         return self._model["name"]                                               
 87 │ 87 │                                                                                  
 88 │ 88 │     @property                                                                    
 89 │ 89 │     def language(self) -> str:                                                   
 90 │ 90 │         return self._model["language"]                                           

